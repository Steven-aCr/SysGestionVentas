            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="producto">
                <span class="bi bi-box-seam-nav-menu" aria-hidden="true"></span> Productos
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="categoria">
                <span class="bi bi-tags-nav-menu" aria-hidden="true"></span> Categorías
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="inventario">
                <span class="bi bi-journal-text-nav-menu" aria-hidden="true"></span> Inventario
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="movimientoinventario">
                <span class="bi bi-arrow-left-right-nav-menu" aria-hidden="true"></span> Movimientos
