@page "/inventario"

@using Microsoft.AspNetCore.Authorization
@using SysGestionVentas.ApiClient.DTOs.Inventario
@using SysGestionVentas.ApiClient.Services.Interfaces

@attribute [Authorize(Roles = "Administrador")]

@inject IInventarioApiService InventarioService

<PageTitle>Inventario</PageTitle>

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Inventario</h2>

        <button class="btn btn-outline-secondary"
                @onclick="CargarInventario"
                disabled="@cargando">
            Actualizar
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(mensajeError))
    {
        <div class="alert alert-danger">
            @mensajeError
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(mensajeExito))
    {
        <div class="alert alert-success">
            @mensajeExito
        </div>
    }

    <div class="row">

        <div class="col-lg-4 mb-4">

            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        @(editando
                            ? "Modificar inventario"
                            : "Nuevo inventario")
                    </h5>
                </div>

                <div class="card-body">

                    @if (editando)
                    {
                        <EditForm Model="@inventarioModificar"
                                  OnValidSubmit="@ModificarInventario">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">
                                    Precio de compra
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioModificar.PrecioCompra" />

                                <ValidationMessage For="@(() => inventarioModificar.PrecioCompra)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Precio de venta
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioModificar.PrecioVenta" />

                                <ValidationMessage For="@(() => inventarioModificar.PrecioVenta)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Stock mínimo
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioModificar.StockMinimo" />

                                <ValidationMessage For="@(() => inventarioModificar.StockMinimo)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Estado
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioModificar.IdEstado" />

                                <ValidationMessage For="@(() => inventarioModificar.IdEstado)" />
                            </div>

                            <div class="d-grid gap-2">

                                <button type="submit"
                                        class="btn btn-primary"
                                        disabled="@procesando">

                                    @(procesando
                                        ? "Guardando..."
                                        : "Guardar cambios")

                                </button>

                                <button type="button"
                                        class="btn btn-outline-secondary"
                                        @onclick="CancelarEdicion"
                                        disabled="@procesando">

                                    Cancelar

                                </button>

                            </div>

                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="@inventarioGuardar"
                                  OnValidSubmit="@CrearInventario">

                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label">
                                    ID Producto
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioGuardar.IdProducto" />

                                <ValidationMessage For="@(() => inventarioGuardar.IdProducto)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Precio de compra
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioGuardar.PrecioCompra" />

                                <ValidationMessage For="@(() => inventarioGuardar.PrecioCompra)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Stock actual
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioGuardar.StockActual" />

                                <ValidationMessage For="@(() => inventarioGuardar.StockActual)" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">
                                    Stock mínimo
                                </label>

                                <InputNumber class="form-control"
                                             @bind-Value="inventarioGuardar.StockMinimo" />

                                <ValidationMessage For="@(() => inventarioGuardar.StockMinimo)" />
                            </div>

                            <button type="submit"
                                    class="btn btn-primary w-100"
                                    disabled="@procesando">

                                @(procesando
                                    ? "Guardando..."
                                    : "Registrar inventario")

                            </button>

                        </EditForm>
                    }

                </div>

            </div>

        </div>

        <div class="col-lg-8">

            <div class="card shadow-sm">

                <div class="card-header bg-white">
                    <h5 class="mb-0">
                        Registros de inventario
                    </h5>
                </div>

                <div class="card-body p-0">

                    @if (cargando)
                    {
                        <div class="text-center p-5">

                            <div class="spinner-border text-primary"
                                 role="status">
                            </div>

                            <p class="mt-2 mb-0 text-muted">
                                Cargando inventario...
                            </p>

                        </div>
                    }
                    else if (inventarios.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            No hay registros de inventario.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table table-hover align-middle mb-0">

                                <thead class="table-light">

                                    <tr>
                                        <th>ID</th>
                                        <th>Producto</th>
                                        <th>Compra</th>
                                        <th>Venta</th>
                                        <th>Stock</th>
                                        <th>Mínimo</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in inventarios)
                                    {
                                        <tr>

                                            <td>
                                                @item.IdInventario
                                            </td>

                                            <td>
                                                @item.IdProducto
                                            </td>

                                            <td>
                                                $@item.PrecioCompra.ToString("F2")
                                            </td>

                                            <td>
                                                $@item.PrecioVenta.ToString("F2")
                                            </td>

                                            <td>

                                                <span class="badge @ClaseStock(item)">
                                                    @item.StockActual
                                                </span>

                                            </td>

                                            <td>
                                                @item.StockMinimo
                                            </td>

                                            <td>
                                                @item.IdEstado
                                            </td>

                                            <td>

                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => PrepararEdicion(item)">
                                                    Editar
                                                </button>

                                                <a class="btn btn-sm btn-outline-secondary ms-1"
                                                   href="@($"/movimientoinventario?inventario={item.IdInventario}")">
                                                    Movimientos
                                                </a>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    private List<InventarioSalida> inventarios = new();

    private InventarioGuardar inventarioGuardar = new();

    private InventarioModificar inventarioModificar = new();

    private bool cargando;

    private bool procesando;

    private bool editando;

    private string? mensajeError;

    private string? mensajeExito;


    protected override async Task OnInitializedAsync()
    {
        await CargarInventario();
    }


    private async Task CargarInventario()
    {
        cargando = true;

        mensajeError = null;

        try
        {
            inventarios =
                await InventarioService.ObtenerTodosAsync();
        }
        catch (Exception ex)
        {
            inventarios = new();

            mensajeError =
                $"No fue posible cargar el inventario: {ex.Message}";
        }
        finally
        {
            cargando = false;
        }
    }


    private async Task CrearInventario()
    {
        procesando = true;

        LimpiarMensajes();

        try
        {
            var creado =
                await InventarioService.CrearAsync(
                    inventarioGuardar);

            if (creado is null)
            {
                mensajeError =
                    "No fue posible registrar el inventario.";

                return;
            }

            inventarioGuardar =
                new InventarioGuardar();

            mensajeExito =
                "Inventario registrado correctamente.";

            await CargarInventario();
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No fue posible registrar el inventario: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }


    private void PrepararEdicion(
        InventarioSalida item)
    {
        LimpiarMensajes();

        inventarioModificar =
            new InventarioModificar
            {
                IdInventario =
                    item.IdInventario,

                PrecioCompra =
                    item.PrecioCompra,

                PrecioVenta =
                    item.PrecioVenta,

                StockMinimo =
                    item.StockMinimo,

                IdEstado =
                    item.IdEstado
            };

        editando = true;
    }


    private async Task ModificarInventario()
    {
        procesando = true;

        LimpiarMensajes();

        try
        {
            var modificado =
                await InventarioService.ModificarAsync(
                    inventarioModificar);

            if (modificado is null)
            {
                mensajeError =
                    "No fue posible modificar el inventario.";

                return;
            }

            inventarioModificar =
                new InventarioModificar();

            editando = false;

            mensajeExito =
                "Inventario modificado correctamente.";

            await CargarInventario();
        }
        catch (Exception ex)
        {
            mensajeError =
                $"No fue posible modificar el inventario: {ex.Message}";
        }
        finally
        {
            procesando = false;
        }
    }


    private void CancelarEdicion()
    {
        inventarioModificar =
            new InventarioModificar();

        editando = false;

        LimpiarMensajes();
    }


    private static string ClaseStock(
        InventarioSalida item)
    {
        if (item.StockActual <= 0)
        {
            return "bg-danger";
        }

        if (item.StockActual <= item.StockMinimo)
        {
            return "bg-warning text-dark";
        }

        return "bg-success";
    }


    private void LimpiarMensajes()
    {
        mensajeError = null;

        mensajeExito = null;
    }
}