@page "/login"

@using SysGestionVentas.ApiClient.DTOs.Auth
@using SysGestionVentas.ApiClient.Services.Interfaces

@inject IAuthApiService AuthService
@inject NavigationManager Navigation

<div class="container mt-5 d-flex justify-content-center">
    <div class="card shadow p-4" style="width: 100%; max-width: 400px;">
        <h3 class="text-center mb-4">Iniciar Sesión</h3>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input type="email"
                       class="form-control"
                       @bind="loginModel.Email"
                       placeholder="correo@ejemplo.com"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Contraseña</label>
                <input type="password"
                       class="form-control"
                       @bind="loginModel.Password"
                       placeholder="••••••••"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-primary w-100 mt-2"
                    disabled="@cargando">

                @if (cargando)
                {
                    <span class="spinner-border spinner-border-sm me-2"
                          role="status"></span>
                    <span>Iniciando sesión...</span>
                }
                else
                {
                    <span>Ingresar</span>
                }
            </button>
        </EditForm>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-danger mt-3 text-center" role="alert">
                @mensajeError
            </div>
        }
    </div>
</div>

@code {
    private LoginRequest loginModel = new();
    private string mensajeError = string.Empty;
    private bool cargando;

    private async Task HandleLogin()
    {
        cargando = true;
        mensajeError = string.Empty;

        try
        {
            var result = await AuthService.LoginAsync(loginModel);

            if (result is not null &&
                !string.IsNullOrWhiteSpace(result.Token))
            {
                Navigation.NavigateTo("/");
                return;
            }

            mensajeError = "Correo electrónico o contraseña incorrectos.";
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible comunicarse con el servidor.";
        }
        catch (TaskCanceledException)
        {
            mensajeError = "El servidor tardó demasiado en responder.";
        }
        finally
        {
            cargando = false;
        }
    }
}