@page "/productos"
@using ApiInventario.Client.DTOs
@inject HttpClient Http

<PageTitle>Productos - Inventario</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Gestión de Productos</h2>
        <button class="btn btn-success" @onclick="AbrirModalNuevo">
            <i class="bi bi-plus-lg me-1"></i> Nuevo Producto
        </button>
    </div>

    @if (cargando)
    {
        <div class="text-center my-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Cargando productos desde Render...</p>
        </div>
    }
    else if (productos == null || !productos.Any())
    {
        <div class="alert alert-info text-center">No hay productos registrados en el sistema.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover align-middle bg-white mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th>Descripción</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in productos)
                    {
                        <tr>
                            <td>@prod.Id</td>
                            <td class="fw-bold">@prod.Nombre</td>
                            <td>@prod.Descripcion</td>
                            <td>$@prod.Precio.ToString("F2")</td>
                            <td>
                                <span class="badge @(prod.Stock > 5 ? "bg-success" : "bg-danger")">
                                    @prod.Stock
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => EliminarProducto(prod.Id)">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ProductoDto>? productos;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        cargando = true;
        try
        {
            productos = await Http.GetFromJsonAsync<List<ProductoDto>>("api/productos");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al cargar productos: {ex.Message}");
        }
        finally
        {
            cargando = false;
        }
    }

    private void AbrirModalNuevo()
    {
        // Lógica para abrir modal o redirigir a formulario
    }

    private async Task EliminarProducto(long id)
    {
        var response = await Http.DeleteAsync($"api/productos/{id}");
        if (response.IsSuccessStatusCode)
        {
            await CargarProductos();
        }
    }

    public class ProductoDto
    {
        public long Id { get; set; }
        public string Nombre { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public decimal Precio { get; set; }
        public int Stock { get; set; }
    }
}