<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — SysGestionVentas</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Material Symbols -->
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- Sistema de diseño -->
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/documents.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    }

    <div class="app-shell">

        @* ───────────── SIDEBAR SEGÚN ROL ───────────── *@
        @if (User.Identity?.IsAuthenticated == true)
        {
            if (User.IsInRole("Administrador"))
            {
                <partial name="_AdminMenu" />
            }
            else if (User.IsInRole("Vendedor"))
            {
                <partial name="_VendedorMenu" />
            }
            else if (User.IsInRole("Cliente"))
            {
                <partial name="_ClienteMenu" />
            }
        }

        @* ───────────── CONTENIDO PRINCIPAL ───────────── *@
        <div class="main-wrapper">

            <!-- TOPBAR -->
            <header class="topbar">

                <nav class="topbar__breadcrumb" aria-label="Ruta de navegación">
                    @if (ViewData["BreadcrumbParent"] != null)
                    {
                        <span class="topbar__breadcrumb-item">
                            @ViewData["BreadcrumbParent"]
                        </span>

                        <span class="material-symbols-outlined topbar__breadcrumb-sep">
                            chevron_right
                        </span>
                    }

                    <span class="topbar__breadcrumb-item topbar__breadcrumb-item--current">
                        @(ViewData["Title"] ?? currentController)
                    </span>
                </nav>

                <div class="topbar__search">
                    <span class="material-symbols-outlined topbar__search-icon">
                        search
                    </span>

                    <input type="search"
                           class="topbar__search-input"
                           placeholder="Buscar..."
                           aria-label="Buscar" />
                </div>

                <div class="topbar__actions">
                    <button type="button"
                            class="topbar__icon-btn"
                            aria-label="Notificaciones">
                        <span class="material-symbols-outlined">notifications</span>
                    </button>

                    <button type="button"
                            class="topbar__icon-btn"
                            aria-label="Ayuda">
                        <span class="material-symbols-outlined">help_outline</span>
                    </button>
                </div>
            </header>

            <!-- CONTENIDO -->
            <main class="page-content">
                <div class="page-content">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert-custom alert-success-custom" role="alert">
                            <span class="material-symbols-outlined">check_circle</span>
                            <p class="mb-0">@TempData["Success"]</p>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert-custom alert-danger-custom" role="alert">
                            <span class="material-symbols-outlined">error</span>
                            <p class="mb-0">@TempData["Error"]</p>
                        </div>
                    }

                    @if (TempData["Warning"] != null)
                    {
                        <div class="alert-custom alert-warning-custom" role="alert">
                            <span class="material-symbols-outlined">warning</span>
                            <p class="mb-0">@TempData["Warning"]</p>
                        </div>
                    }

                    @RenderBody()
                </div>
            </main>

            <!-- FOOTER -->
            <footer class="app-footer">
                <span>&copy; @DateTime.Now.Year — SysGestionVentas</span>

                <a asp-controller="Home"
                       asp-action="Privacy">
                    Privacidad
                </a>
            </footer>

        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- Bootstrap Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Scripts del proyecto -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/forms.js" asp-append-version="true"></script>
    <script src="~/js/createDoc.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>