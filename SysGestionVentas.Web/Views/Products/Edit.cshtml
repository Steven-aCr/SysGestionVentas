@model SysGestionVentas.EN.ProductList

@{
    ViewData["Title"] = "Editar Producto";
    ViewData["BreadcrumbParent"] = "Productos";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Editar Producto</h1>
        <p class="page-header__subtitle">
            Producto: <strong>@(Model.Name ?? $"ID #{Model.ProductId}")</strong>
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn btn-light">
            <span class="material-symbols-outlined">visibility</span>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- ── FORMULARIO ─────────────────────────────────── -->
    <div class="col-lg-8">
        <div class="card">

            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">edit</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Actualizar Datos
                </span>
                <span class="badge badge-neutral ms-auto">ID #@Model.ProductId</span>
            </div>

            <div style="padding:24px;">
                <form asp-action="Edit" class="needs-validation" novalidate>

                    <div asp-validation-summary="ModelOnly"
                         class="alert-custom alert-danger-custom mb-4"
                         role="alert"
                         style="display:none;"></div>

                    <input type="hidden" asp-for="ProductId" />
                    <input type="hidden" asp-for="CreatedByUser" />

                    <!-- Sección: Información General -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <span class="material-symbols-outlined form-section__icon">info</span>
                            <span class="form-section__title">Información General</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Nombre del Producto <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descripción</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <!-- Sección: Identificación -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <span class="material-symbols-outlined form-section__icon">qr_code</span>
                            <span class="form-section__title">Identificación</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Barcode" class="form-label">
                                Código de Barras <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left">
                                    <span class="material-symbols-outlined" style="font-size:18px;">barcode</span>
                                </span>
                                <input asp-for="Barcode" class="form-control" required />
                            </div>
                            <span asp-validation-for="Barcode"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">URL de Imagen</label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left">
                                    <span class="material-symbols-outlined" style="font-size:18px;">image</span>
                                </span>
                                <input asp-for="ImageUrl"
                                       class="form-control"
                                       id="ImageUrl"
                                       placeholder="https://ejemplo.com/imagen.jpg" />
                            </div>
                            <span asp-validation-for="ImageUrl"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <!-- Sección: Clasificación -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <span class="material-symbols-outlined form-section__icon">category</span>
                            <span class="form-section__title">Clasificación</span>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label">
                                    Categoría <span style="color:var(--clr-danger);">*</span>
                                </label>
                                <select asp-for="CategoryId"
                                        asp-items="ViewBag.CategoryList"
                                        class="form-select"
                                        required>
                                    <option value="">— Seleccione una categoría —</option>
                                </select>
                                <span asp-validation-for="CategoryId"
                                      class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="StatusId" class="form-label">
                                    Estado <span style="color:var(--clr-danger);">*</span>
                                </label>
                                <select asp-for="StatusId"
                                        asp-items="ViewBag.StatusList"
                                        class="form-select"
                                        required>
                                    <option value="">— Seleccione un estado —</option>
                                </select>
                                <span asp-validation-for="StatusId"
                                      class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border); margin:24px 0;" />

                    <!-- Botones -->
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@Model.ProductId"
                           class="btn btn-danger-outline ms-auto"
                           style="font-size:.84rem;">
                            <span class="material-symbols-outlined">block</span>
                            Desactivar
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- ── PANEL LATERAL ──────────────────────────────── -->
    <div class="col-lg-4">
        <div style="position:sticky; top:calc(var(--topbar-h) + 16px);">

            <!-- Vista previa de imagen -->
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="card mb-3">
                    <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                        display:flex; align-items:center; gap:10px;">
                        <span class="material-symbols-outlined"
                              style="color:var(--clr-primary); font-size:18px;">image</span>
                        <span style="font-size:.88rem; font-weight:700; color:var(--clr-text);">
                            Imagen Actual
                        </span>
                    </div>
                    <div style="padding:16px; text-align:center;">
                        <img id="imagePreview"
                             src="@Model.ImageUrl"
                             alt="@Model.Name"
                             style="max-width:100%; max-height:180px;
                                    border-radius:var(--radius-md);
                                    object-fit:contain;" />
                    </div>
                </div>
            }
            else
            {
                <div class="card mb-3" id="imagePreviewCard" style="display:none;">
                    <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                        display:flex; align-items:center; gap:10px;">
                        <span class="material-symbols-outlined"
                              style="color:var(--clr-primary); font-size:18px;">preview</span>
                        <span style="font-size:.88rem; font-weight:700;">Vista Previa</span>
                    </div>
                    <div style="padding:16px; text-align:center;">
                        <img id="imagePreview" src="" alt="Vista previa"
                             style="max-width:100%; max-height:180px;
                                    border-radius:var(--radius-md); object-fit:contain;" />
                    </div>
                </div>
            }

            <!-- Información del registro -->
            <div class="card mb-3">
                <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                    display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined"
                          style="color:var(--clr-primary); font-size:18px;">analytics</span>
                    <span style="font-size:.88rem; font-weight:700; color:var(--clr-text);">
                        Información del Registro
                    </span>
                </div>
                <div>
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border); font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Categoría</span>
                        <span style="font-weight:600;">@(Model.Category?.Name ?? "—")</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border); font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Barcode</span>
                        <span style="font-family:monospace; font-size:.8rem;">@Model.Barcode</span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Creado</span>
                        <span style="font-weight:600;">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Acceso rápido a inventario -->
            @if (Model.Inventory != null)
            {
                <div class="alert-custom alert-success-custom" style="border-radius:var(--radius-lg);">
                    <span class="material-symbols-outlined" style="flex-shrink:0;">inventory_2</span>
                    <div style="font-size:.81rem;">
                        <strong>Stock actual:</strong> @Model.Inventory.CurrentStock uds<br>
                        <strong>Precio venta:</strong> $@Model.Inventory.SalePrice.ToString("F2")<br>
                        <a asp-controller="Inventories"
                           asp-action="Edit"
                           asp-route-id="@Model.Inventory.InventoryId"
                           style="color:var(--clr-primary); font-weight:600;">
                            Editar inventario →
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="alert-custom alert-warning-custom" style="border-radius:var(--radius-lg);">
                    <span class="material-symbols-outlined" style="flex-shrink:0;">warning</span>
                    <div style="font-size:.81rem;">
                        <strong>Sin inventario:</strong> Este producto no tiene registro de inventario aún.<br>
                        <a asp-controller="Inventories"
                           asp-action="Create"
                           style="color:var(--clr-warning); font-weight:600;">
                            Registrar inventario →
                        </a>
                    </div>
                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        const imageUrlInput = document.getElementById('ImageUrl');
        const previewCard   = document.getElementById('imagePreviewCard');
        const previewImg    = document.getElementById('imagePreview');

        if (imageUrlInput) {
            imageUrlInput.addEventListener('input', function () {
                const url = this.value.trim();
                if (url && previewImg) {
                    previewImg.src = url;
                    if (previewCard) {
                        previewImg.onload  = () => previewCard.style.display = 'block';
                        previewImg.onerror = () => previewCard.style.display = 'none';
                    }
                } else if (previewCard) {
                    previewCard.style.display = 'none';
                }
            });
        }
    </script>
}
