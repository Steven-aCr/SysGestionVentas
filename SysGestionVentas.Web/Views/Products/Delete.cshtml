@model SysGestionVentas.EN.ProductList

@{
    ViewData["Title"] = "Desactivar Producto";
    ViewData["BreadcrumbParent"] = "Productos";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Desactivar Producto</h1>
        <p class="page-header__subtitle">
            Esta operación es reversible. Podrá reactivar el producto desde la vista de edición.
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-6 col-md-8">

        <!-- Alerta de confirmación -->
        <div class="alert-custom alert-danger-custom mb-4"
             style="border-radius:var(--radius-lg); align-items:flex-start;">
            <span class="material-symbols-outlined" style="flex-shrink:0; margin-top:1px;">warning</span>
            <div>
                <strong>¿Está seguro?</strong> El producto
                <strong>@(Model.Name ?? $"#{Model.ProductId}")</strong>
                será marcado como inactivo y no estará disponible en documentos ni en el catálogo.
            </div>
        </div>

        <!-- Imagen del producto si existe -->
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="card mb-4" style="text-align:center; padding:20px;">
                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     style="max-height:160px; max-width:100%;
                border-radius:var(--radius-md); object-fit:contain;" />
            </div>
        }

        <!-- Resumen del registro -->
        <div class="card mb-4">
            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">package_2</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Datos del Producto
                </span>
            </div>

            <div>
                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border); font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">ID</span>
                    <span style="font-weight:700;">#@Model.ProductId</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border); font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Nombre</span>
                    <span style="font-weight:700;">@Model.Name</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border); font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Código de barras</span>
                    <code style="font-size:.82rem; background:var(--clr-surface-alt);
                        padding:2px 8px; border-radius:var(--radius-sm);
                        border:1px solid var(--clr-border);">
                        @Model.Barcode
                    </code>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border); font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Categoría</span>
                    <span style="font-weight:600;">@(Model.Category?.Name ?? "—")</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border); font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Creado por</span>
                    <span style="color:var(--clr-text-muted);">@(Model.CreatedBy?.Email ?? "—")</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Estado actual</span>
                    <span class="badge badge-vendedor">
                        <span class="status-dot status-dot--active"></span>
                        &nbsp;@(Model.Status?.Name ?? "Activo")
                    </span>
                </div>
            </div>
        </div>

        <!-- Formulario de confirmación -->
        <form asp-action="Delete">
            <input type="hidden" asp-for="ProductId" />
            <div class="d-flex gap-3 align-items-center">
                <button type="submit"
                        class="btn btn-primary"
                        style="background:var(--clr-danger); border-color:var(--clr-danger);">
                    <span class="material-symbols-outlined">block</span>
                    Sí, desactivar
                </button>
                <a asp-action="Index" class="btn btn-light">
                    <span class="material-symbols-outlined">close</span>
                    Cancelar
                </a>
                <a asp-action="Details"
                       asp-route-id="@Model.ProductId"
                       class="btn btn-light ms-auto">
                    <span class="material-symbols-outlined">visibility</span>
                    Ver detalle
                </a>
            </div>
        </form>

    </div>
</div>
