@model SysGestionVentas.EN.Supplier

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Supplier</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Company Name</dt>
        <dd class="col-sm-10">@Model.CompanyName</dd>
        
        <dt class="col-sm-2">NIT</dt>
        <dd class="col-sm-10">@Model.Nit</dd>
        
        <dt class="col-sm-2">NRC</dt>
        <dd class="col-sm-10">@Model.Nrc</dd>
        
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.StatusId</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.SupplierId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
