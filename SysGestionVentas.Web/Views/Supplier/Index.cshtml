@model IEnumerable<SysGestionVentas.EN.Supplier>

@{
    ViewData["Title"] = "Suppliers";
}

<h1>Suppliers</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Supplier</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Company Name</th>
            <th>NIT</th>
            <th>NRC</th>
            <th>Description</th>
            <th>Status ID</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.CompanyName</td>
                <td>@supplier.Nit</td>
                <td>@supplier.Nrc</td>
                <td>@supplier.Description</td>
                <td>@supplier.StatusId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@supplier.SupplierId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@supplier.SupplierId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@supplier.SupplierId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
