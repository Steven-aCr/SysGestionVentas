@model SysGestionVentas.EN.Status

@{
    ViewData["Title"] = "Nuevo Estado";
    ViewData["BreadcrumbParent"] = "Estados";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Nuevo Estado</h1>
        <p class="page-header__subtitle">Defina un estado para los registros del sistema.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">toggle_on</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Datos del Estado</span>
            </div>
            <div style="padding:24px;">
                <form asp-action="Create" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Nombre <span style="color:var(--clr-danger)">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="Ej: Activo, Inactivo, Suspendido…" required />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Descripción</label>
                        <textarea asp-for="Description" class="form-control" rows="2" style="resize:vertical;"></textarea>
                        <span asp-validation-for="Description" class="text-danger" style="font-size:.78rem;"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="StatusTypeId" class="form-label">Tipo de Estado <span style="color:var(--clr-danger)">*</span></label>
                        <select asp-for="StatusTypeId" asp-items="ViewBag.StatusTypeId" class="form-select" required>
                            <option value="">— Seleccione un tipo —</option>
                        </select>
                        <span asp-validation-for="StatusTypeId" class="text-danger" style="font-size:.78rem;"></span>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" style="width:2.2em;height:1.2em;" />
                            <label asp-for="IsActive" class="form-check-label ms-2" style="font-weight:600;color:var(--clr-text);">Estado activo</label>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border);margin:24px 0;" />

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Estado
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
