@model IEnumerable<SysGestionVentas.EN.ProductList>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Barcode</th>
            <th>Description</th>
            <th>Status ID</th>
            <th>Category ID</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Barcode</td>
                <td>@product.Description</td>
                <td>@product.StatusId</td>
                <td>@product.CategoryId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@product.ProductId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@product.ProductId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@product.ProductId">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>
