@model SysGestionVentas.EN.ProductList

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>
        
        <dt class="col-sm-2">Barcode</dt>
        <dd class="col-sm-10">@Model.Barcode</dd>
        
        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@Model.Description</dd>
        
        <dt class="col-sm-2">Image URL</dt>
        <dd class="col-sm-10">@Model.ImageUrl</dd>
        
        <dt class="col-sm-2">Status</dt>
        <dd class="col-sm-10">@Model.StatusId</dd>
        
        <dt class="col-sm-2">Category</dt>
        <dd class="col-sm-10">@Model.CategoryId</dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.ProductId">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
