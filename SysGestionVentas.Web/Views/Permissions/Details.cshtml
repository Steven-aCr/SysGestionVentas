@model SysGestionVentas.EN.Permission

@{
    ViewData["Title"] = "Detalle de Permiso";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Detalle de Permiso</h1>
        <p class="page-header__subtitle">Información completa del permiso <strong>@Model.Name</strong>.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.PermissionId" class="btn btn-primary">
            <span class="material-symbols-outlined">edit</span>
            Editar
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-6 col-md-8">

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);
                display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary);font-size:20px;">key</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">
                    Información del Permiso
                </span>
            </div>

            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">ID</span>
                    <code style="background:var(--clr-surface-alt);padding:2px 10px;
                        border-radius:var(--radius-sm);font-size:.82rem;">
                        #@Model.PermissionId
                    </code>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:flex-start;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Nombre</span>
                    <strong style="max-width:60%;text-align:right;">@Model.Name</strong>
                </div>

                <div style="padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);display:block;margin-bottom:6px;">
                        Descripción
                    </span>
                    <p style="color:var(--clr-text);margin:0;line-height:1.6;">
                        @(Model.Description ?? "Sin descripción registrada.")
                    </p>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Estado</span>
                    @if (Model.IsActive)
                    {
                        <span class="badge badge-vendedor">
                            <span class="status-dot status-dot--active"></span>
                            &nbsp;Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-neutral">
                            <span class="status-dot status-dot--inactive"></span>
                            &nbsp;Inactivo
                        </span>
                    }
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Fecha de creación</span>
                    <span>@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.PermissionId" class="btn btn-primary">
                <span class="material-symbols-outlined">edit</span>
                Editar permiso
            </a>
            <a asp-action="Delete" asp-route-id="@Model.PermissionId" class="btn btn-danger-outline">
                <span class="material-symbols-outlined">block</span>
                Desactivar
            </a>
            <a asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">list</span>
                Listado
            </a>
        </div>

    </div>
</div>
