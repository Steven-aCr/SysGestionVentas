@model SysGestionVentas.EN.Employee

@{
    ViewData["Title"] = "Editar Empleado";
    var initials = string.Concat(
        Model.Person?.FirstName?.Length > 0 ? Model.Person.FirstName[0].ToString() : "",
        Model.Person?.LastName?.Length > 0  ? Model.Person.LastName[0].ToString()  : ""
    ).ToUpper();
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Editar Empleado</h1>
        <p class="page-header__subtitle">
            Modifica los datos laborales de
            <strong>@(Model.Person?.FullName ?? $"Empleado #{Model.EmployeeId}")</strong>.
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.EmployeeId" class="btn btn-light">
            <span class="material-symbols-outlined">visibility</span>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-8">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);
                        display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary);font-size:20px;">work</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">
                    Datos Laborales
                </span>
            </div>

            <div class="card-body p-4">
                <form asp-action="Edit" autocomplete="off">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EmployeeId" />
                    <input type="hidden" asp-for="PersonId" />

                    <div asp-validation-summary="ModelOnly"
                         class="alert-custom alert-danger-custom mb-4"
                         style="border-radius:var(--radius-md);">
                    </div>

                    <div class="row g-3">

                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label">
                                Código de empleado <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left material-symbols-outlined">
                                    badge
                                </span>
                                <input asp-for="EmployeeCode" class="form-control"
                                       placeholder="Ej. EMP-001" />
                            </div>
                            <span asp-validation-for="EmployeeCode" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HireDate" class="form-label">
                                Fecha de contratación <span class="text-danger">*</span>
                            </label>
                            <input asp-for="HireDate" type="date" class="form-control" />
                            <span asp-validation-for="HireDate" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Salary" class="form-label">
                                Salario mensual <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Salary" type="number" step="0.01" min="0.01"
                                       class="form-control" placeholder="0.00"
                                       data-type="currency" />
                            </div>
                            <span asp-validation-for="Salary" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label">Departamento</label>
                            <select asp-for="DepartmentId" class="form-select"
                                    asp-items="ViewBag.DepartmentList">
                                <option value="">— Sin departamento —</option>
                            </select>
                            <span asp-validation-for="DepartmentId" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="UserId" class="form-label">Usuario del sistema</label>
                            <select asp-for="UserId" class="form-select"
                                    asp-items="ViewBag.UserList">
                                <option value="">— Sin usuario asociado —</option>
                            </select>
                            <span asp-validation-for="UserId" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StatusId" class="form-label">
                                Estado <span class="text-danger">*</span>
                            </label>
                            <select asp-for="StatusId" class="form-select"
                                    asp-items="ViewBag.StatusList">
                                <option value="">— Seleccione un estado —</option>
                            </select>
                            <span asp-validation-for="StatusId" class="field-validation-error"></span>
                        </div>

                    </div>

                    <div class="alert-custom alert-warning-custom mt-4"
                         style="border-radius:var(--radius-md);">
                        <span class="material-symbols-outlined" style="flex-shrink:0;">info</span>
                        <span>
                            Los datos personales (nombre, teléfono, dirección, DUI) se editan
                            a través del módulo de <strong>Personas</strong>.
                        </span>
                    </div>

                    <div class="form-actions form-actions--end mt-4">
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">
            <div class="card">
                <div style="padding:28px 22px;text-align:center;">
                    <div style="width:64px;height:64px;border-radius:50%;
                                background:linear-gradient(135deg,var(--clr-primary),var(--clr-primary-dark));
                                color:#fff;display:inline-flex;align-items:center;
                                justify-content:center;font-size:1.4rem;font-weight:800;
                                margin-bottom:12px;">
                        @initials
                    </div>
                    <div style="font-weight:700;font-size:.96rem;color:var(--clr-text);">
                        @(Model.Person?.FullName ?? "—")
                    </div>
                    <div style="font-size:.8rem;color:var(--clr-text-muted);margin-top:3px;">
                        @(Model.Person?.PhoneNumber ?? "—")
                    </div>
                    <div class="mt-2">
                        <code style="background:var(--clr-primary-light);
                                     color:var(--clr-primary-dark);
                                     padding:2px 10px;border-radius:999px;
                                     font-size:.78rem;font-weight:700;">
                            @Model.EmployeeCode
                        </code>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
