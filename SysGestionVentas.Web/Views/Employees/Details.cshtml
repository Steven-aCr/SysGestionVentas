@model SysGestionVentas.EN.Employee

@{
    ViewData["Title"] = "Detalle de Empleado";
    var initials = string.Concat(
        Model.Person?.FirstName?.Length > 0 ? Model.Person.FirstName[0].ToString() : "",
        Model.Person?.LastName?.Length > 0 ? Model.Person.LastName[0].ToString() : ""
    ).ToUpper();
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Detalle de Empleado</h1>
        <p class="page-header__subtitle">
            @(Model.Person?.FullName ?? $"Empleado #{Model.EmployeeId}") —
            Código <strong>@Model.EmployeeCode</strong>
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">
            <span class="material-symbols-outlined">edit</span>
            Editar
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-8">

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);
                display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary);font-size:20px;">work</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">
                    Datos Laborales
                </span>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Código de empleado</span>
                    <code style="background:var(--clr-surface-alt);padding:2px 10px;
                        border-radius:var(--radius-sm);font-size:.82rem;">
                        @Model.EmployeeCode
                    </code>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Departamento</span>
                    <span class="badge badge-admin">@(Model.Department?.Name ?? "Sin asignar")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Fecha de contratación</span>
                    <span>@Model.HireDate.ToString("dd MMMM yyyy")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Salario mensual</span>
                    <strong style="font-size:1rem;color:var(--clr-success);">
                        $@Model.Salary.ToString("F2")
                    </strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Estado</span>
                    @if (Model.Status?.Name == "Activo")
                    {
                        <span class="badge badge-vendedor">
                            <span class="status-dot status-dot--active"></span>
                            &nbsp;Activo
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-neutral">
                            <span class="status-dot status-dot--inactive"></span>
                            &nbsp;@(Model.Status?.Name ?? "Inactivo")
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);
                display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary);font-size:20px;">person</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">
                    Datos Personales
                </span>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Nombre completo</span>
                    <strong>@(Model.Person?.FullName ?? "—")</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Teléfono</span>
                    <span>@(Model.Person?.PhoneNumber ?? "—")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">DUI</span>
                    <span>@(Model.Person?.Dui ?? "—")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:14px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Dirección</span>
                    <span style="color:var(--clr-text-muted);max-width:60%;text-align:right;">
                        @(Model.Person?.Adress ?? "—")
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">
                <span class="material-symbols-outlined">edit</span>
                Editar empleado
            </a>
            <a asp-action="Delete" asp-route-id="@Model.EmployeeId" class="btn btn-danger-outline">
                <span class="material-symbols-outlined">block</span>
                Desactivar
            </a>
            <a asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">list</span>
                Listado
            </a>
        </div>

    </div>

    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">

            <div class="card mb-3">
                <div style="padding:28px 22px;text-align:center;">
                    <div style="width:70px;height:70px;border-radius:50%;
                        background:linear-gradient(135deg,var(--clr-primary),var(--clr-primary-dark));
                        color:#fff;display:inline-flex;align-items:center;
                        justify-content:center;font-size:1.5rem;font-weight:800;
                        margin-bottom:14px;">
                        @initials
                    </div>
                    <div style="font-weight:700;font-size:.97rem;color:var(--clr-text);">
                        @(Model.Person?.FullName ?? "—")
                    </div>
                    <div style="font-size:.8rem;color:var(--clr-text-muted);margin-top:3px;">
                        @(Model.Department?.Name ?? "Sin departamento")
                    </div>
                </div>
            </div>

            @if (Model.User != null)
            {
                <div class="card">
                    <div style="padding:14px 18px;border-bottom:1px solid var(--clr-border);
                        display:flex;align-items:center;gap:10px;">
                        <span class="material-symbols-outlined"
                              style="color:var(--clr-primary);font-size:18px;">manage_accounts</span>
                        <span style="font-size:.88rem;font-weight:700;color:var(--clr-text);">
                            Cuenta de usuario
                        </span>
                    </div>
                    <div style="padding:16px;">
                        <div style="font-size:.82rem;color:var(--clr-text-muted);margin-bottom:4px;">
                            Usuario
                        </div>
                        <div style="font-weight:600;font-size:.88rem;margin-bottom:12px;">
                            @Model.User.UserName
                        </div>
                        <div style="font-size:.82rem;color:var(--clr-text-muted);margin-bottom:4px;">
                            Correo
                        </div>
                        <div style="font-size:.82rem;">@Model.User.Email</div>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
