@model SysGestionVentas.EN.Category

@{
    ViewData["Title"] = "Editar Categoría";
    ViewData["BreadcrumbParent"] = "Categorías";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Editar Categoría</h1>
        <p class="page-header__subtitle">
            Categoría: <strong>@(Model.Name ?? $"ID #{Model.CategoryId}")</strong>
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.CategoryId" class="btn btn-light">
            <span class="material-symbols-outlined">visibility</span>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- ── FORMULARIO ─────────────────────────────────── -->
    <div class="col-lg-8">
        <div class="card">

            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">edit</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Actualizar Datos
                </span>
                <span class="badge badge-neutral ms-auto">ID #@Model.CategoryId</span>
            </div>

            <div style="padding:24px;">
                <form asp-action="Edit" class="needs-validation" novalidate>

                    <div asp-validation-summary="ModelOnly"
                         class="alert-custom alert-danger-custom mb-4"
                         role="alert"
                         style="display:none;"></div>

                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="CreatedByUser" />

                    <!-- Sección: Información General -->
                    <div class="form-section">
                        <div class="form-section-header">
                            <span class="material-symbols-outlined form-section__icon">info</span>
                            <span class="form-section__title">Información General</span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Nombre de la Categoría <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descripción</label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <!-- Sección: Estado -->
                    <div class="form-section" style="margin-bottom:0;">
                        <div class="form-section-header">
                            <span class="material-symbols-outlined form-section__icon">toggle_on</span>
                            <span class="form-section__title">Estado del Registro</span>
                        </div>

                        <div>
                            <label asp-for="StatusId" class="form-label">
                                Estado <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <select asp-for="StatusId"
                                    asp-items="ViewBag.StatusList"
                                    class="form-select"
                                    required>
                                <option value="">— Seleccione un estado —</option>
                            </select>
                            <span asp-validation-for="StatusId"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border); margin:24px 0;" />

                    <!-- Botones -->
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                        <a asp-action="Delete"
                               asp-route-id="@Model.CategoryId"
                               class="btn btn-danger-outline ms-auto"
                               style="font-size:.84rem;">
                            <span class="material-symbols-outlined">block</span>
                            Desactivar
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- ── PANEL LATERAL ──────────────────────────────── -->
    <div class="col-lg-4">
        <div style="position:sticky; top:calc(var(--topbar-h) + 16px);">

            <!-- Información del registro -->
            <div class="card mb-3">
                <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                    display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined"
                          style="color:var(--clr-primary); font-size:18px;">analytics</span>
                    <span style="font-size:.88rem; font-weight:700; color:var(--clr-text);">
                        Estado Actual
                    </span>
                </div>
                <div>
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border); font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Estado</span>
                        <span class="badge @(Model.Status?.Name == "Activo" ? "badge-vendedor" : "badge-neutral")">
                            @(Model.Status?.Name ?? "—")
                        </span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border); font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Creado por</span>
                        <span style="font-size:.82rem; color:var(--clr-text-muted);">
                            @(Model.CreatedBy?.Email ?? "—")
                        </span>
                    </div>
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Fecha creación</span>
                        <span style="font-weight:600;">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                    </div>
                </div>
            </div>

            <!-- Nota -->
            <div class="alert-custom alert-warning-custom" style="border-radius:var(--radius-lg);">
                <span class="material-symbols-outlined" style="flex-shrink:0;">info</span>
                <div style="font-size:.81rem;">
                    Desactivar esta categoría impedirá asignarla a nuevos productos, pero no afectará a los productos ya asociados.
                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
