@model SysGestionVentas.EN.User

@{
    ViewData["Title"] = "Desactivar Usuario";
    ViewData["BreadcrumbParent"] = "Usuarios";

    var isActive = Model?.Status?.Name?.Equals("Activo", StringComparison.OrdinalIgnoreCase) ?? false;

    var avatarInitials = (Model?.Person?.FirstName?.Length > 0 && Model?.Person?.LastName?.Length > 0)
        ? $"{Model.Person.FirstName[0]}{Model.Person.LastName[0]}".ToUpper()
        : Model?.UserName?[..1].ToUpper() ?? "?";
}

<div class="page-header">
    <div class="page-header__info">
        <h1 class="page-header__title">Desactivar Usuario</h1>
        <p class="page-header__subtitle">Esta acción realizará una eliminación del registro</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn--secondary">
            <span class="material-symbols-outlined">arrow_back</span>
            Cancelar
        </a>
    </div>
</div>

<div style="max-width:560px">

    @* Alerta de advertencia *@
    <div class="alert alert--warning" style="margin-bottom:var(--space-6)">
        <span class="material-symbols-outlined">warning</span>
        <div class="alert__content">
            <div class="alert__title">Acción irreversible desde esta pantalla</div>
            <p class="alert__text">
                El usuario quedará en estado <strong>Inactivo</strong> y no podrá iniciar sesión.
                El registro no será eliminado físicamente de la base de datos.
            </p>
        </div>
    </div>

    @* Tarjeta de confirmación *@
    <div class="card">
        <div class="card__header">
            <div>
                <div class="card__title">Confirmar desactivación</div>
                <div class="card__subtitle">Revisa los datos antes de continuar</div>
            </div>
            <span class="badge badge--danger">Inactivar</span>
        </div>

        <div class="card__body">

            @* Identidad del usuario *@
            <div style="display:flex;align-items:center;gap:var(--space-4);
                padding:var(--space-4);
                background:var(--color-neutral-50);
                border-radius:var(--border-radius);
                margin-bottom:var(--space-5)">
                <div class="avatar avatar--lg">@avatarInitials</div>
                <div>
                    <div style="font-weight:var(--font-semi);font-size:var(--text-base);
                        color:var(--color-neutral-900)">
                        @Model?.Person?.FullName
                    </div>
                    <div style="font-size:var(--text-sm);color:var(--color-neutral-500)">
                        @Model?.Email
                    </div>
                    <span class="badge badge--primary" style="margin-top:var(--space-1)">
                        @(Model?.Rol?.Name ?? "—")
                    </span>
                </div>
            </div>

            @* Resumen de campos *@
            <dl style="display:grid;grid-template-columns:1fr 1fr;
                gap:var(--space-3) var(--space-6);
                font-size:var(--text-sm)">

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:3px">
                        Usuario
                    </dt>
                    <dd style="color:var(--color-neutral-800);font-family:var(--font-mono)">
                        @Model?.UserName
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:3px">
                        Estado actual
                    </dt>
                    <dd>
                        <div style="display:flex;align-items:center;gap:6px">
                            <span class="status-dot @(isActive ? "status-dot--active" : "status-dot--inactive")"></span>
                            <span>@(Model?.Status?.Name ?? "—")</span>
                        </div>
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:3px">
                        Registrado el
                    </dt>
                    <dd style="color:var(--color-neutral-800)">
                        @Model?.CreatedAt.ToString("dd MMM yyyy")
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:3px">
                        Nuevo estado
                    </dt>
                    <dd>
                        <div style="display:flex;align-items:center;gap:6px">
                            <span class="status-dot status-dot--inactive"></span>
                            <span style="color:var(--color-neutral-500)">Inactivo</span>
                        </div>
                    </dd>
                </div>

            </dl>
        </div>

        <div class="card__footer">
            <a asp-action="Index" class="btn btn--ghost">Cancelar</a>
            <form asp-action="Delete" method="post" style="margin:0">
                <input type="hidden" asp-for="UserId" />
                <button type="submit" class="btn btn--danger">
                    <span class="material-symbols-outlined">block</span>
                    Confirmar Desactivación
                </button>
            </form>
        </div>

    </div>
</div>
