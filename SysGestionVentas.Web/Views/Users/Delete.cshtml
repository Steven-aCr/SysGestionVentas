@model SysGestionVentas.EN.User

@{
    ViewData["Title"] = "Desactivar Usuario";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Desactivar Usuario</h1>
        <p class="page-header__subtitle">El usuario será marcado como inactivo y no podrá iniciar sesión.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-5 col-md-7">

        <div class="alert-custom alert-danger-custom mb-4"
             style="border-radius:var(--radius-lg);align-items:flex-start;">
            <span class="material-symbols-outlined" style="flex-shrink:0;margin-top:1px;">warning</span>
            <div>
                ¿Está seguro de desactivar al usuario
                <strong>@Model.UserName</strong>?
                No podrá iniciar sesión hasta que su estado sea restaurado.
            </div>
        </div>

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);
                display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary);font-size:20px;">manage_accounts</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">
                    Datos del Usuario
                </span>
            </div>

            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Usuario</span>
                    <div style="display:flex;align-items:center;gap:10px;">
                        <div style="width:34px;height:34px;border-radius:50%;
                            background:linear-gradient(135deg,var(--clr-primary),var(--clr-primary-dark));
                            color:#fff;display:flex;align-items:center;justify-content:center;
                            font-size:.8rem;font-weight:700;">
                            @(Model.UserName?.Length > 0 ? Model.UserName[0].ToString().ToUpper() : "U")
                        </div>
                        <strong>@Model.UserName</strong>
                    </div>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Nombre completo</span>
                    <span>@(Model.Person?.FullName ?? "—")</span>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Correo</span>
                    <span style="color:var(--clr-text-muted);">@Model.Email</span>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Rol</span>
                    <span class="badge badge-admin">@(Model.Rol?.Name ?? "—")</span>
                </div>

                <div style="display:flex;justify-content:space-between;align-items:center;
                    padding:13px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Estado actual</span>
                    <div class="status">
                        <span class="status-dot status-dot--active"></span>
                        <span>@(Model.Status?.Name ?? "Activo")</span>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary"
                        style="background:var(--clr-danger);border-color:var(--clr-danger);">
                    <span class="material-symbols-outlined">person_off</span>
                    Sí, desactivar
                </button>
                <a asp-action="Index" class="btn btn-light">
                    <span class="material-symbols-outlined">close</span>
                    Cancelar
                </a>
            </div>
        </form>

    </div>
</div>
