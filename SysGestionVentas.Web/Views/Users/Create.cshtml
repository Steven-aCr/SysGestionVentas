@model SysGestionVentas.EN.ViewModels.CreateUserModel
@using SysGestionVentas.EN.ViewModels

@{
    ViewData["Title"] = "Crear Usuario";
    ViewData["BreadcrumbParent"] = "Usuarios";
    ViewData["BreadcrumbCurrent"] = "Crear Usuario";
}

<div class="page-content">

    <div class="page-header">
        <div class="page-header__info">
            <h1 class="page-header__title">Crear Usuario</h1>
            <p class="page-header__subtitle mb-0">
                Registra una nueva persona y su cuenta de acceso en una sola operación.
            </p>
        </div>
        <div class="page-header__actions">
            <a asp-action="Index" class="btn btn-secondary">
                <span class="material-symbols-outlined">arrow_back</span>
                Volver
            </a>
        </div>
    </div>

    <div class="card" style="max-width:820px;">
        <div class="card-body p-4">

            <form asp-action="Create" id="createUserForm" autocomplete="off" novalidate>
                @Html.AntiForgeryToken()

                @* Resumen de errores del servidor *@
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger d-flex align-items-center gap-2 mb-4"
                     id="serverErrors"
                     style="display:none!important">
                    <span class="material-symbols-outlined flex-shrink-0">error</span>
                    <div></div>
                </div>

                @* ══════════════════════════════════════════
                   SECCIÓN 1 — DATOS PERSONALES
                   ══════════════════════════════════════════ *@
                <div class="form-section mb-4">
                    <div class="form-section__header">
                        <span class="material-symbols-outlined form-section__icon">person</span>
                        <h6 class="form-section__title mb-0">Datos Personales</h6>
                    </div>

                    <div class="row g-3 mt-1">

                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FirstName" class="form-control"
                                   placeholder="Ej. Juan" autocomplete="given-name" />
                            <span asp-validation-for="FirstName" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">
                                Apellido <span class="text-danger">*</span>
                            </label>
                            <input asp-for="LastName" class="form-control"
                                   placeholder="Ej. Pérez" autocomplete="family-name" />
                            <span asp-validation-for="LastName" class="field-validation-error"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Adress" class="form-label">
                                Dirección <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left material-symbols-outlined">
                                    location_on
                                </span>
                                <input asp-for="Adress" class="form-control"
                                       placeholder="Dirección completa de residencia"
                                       autocomplete="street-address" />
                            </div>
                            <span asp-validation-for="Adress" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label">
                                Teléfono <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left material-symbols-outlined">phone</span>
                                <input asp-for="PhoneNumber" id="PhoneNumber"
                                       class="form-control" placeholder="Ej. 7000-0000"
                                       autocomplete="tel"
                                       data-unique-check="PhoneNumber"
                                       data-unique-exclude="0"
                                       data-unique-url="/Users/CheckUnique"
                                       data-unique-msg="Este número de teléfono ya está registrado." />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
                            <div class="unique-feedback invalid-feedback"
                                 id="PhoneNumber-unique-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Dui" class="form-label">DUI</label>
                            <input asp-for="Dui" id="Dui" class="form-control"
                                   placeholder="12345678-9" autocomplete="off"
                                   data-unique-check="Dui"
                                   data-unique-exclude="0"
                                   data-unique-url="/Users/CheckUnique"
                                   data-unique-msg="Este DUI ya está registrado." />
                            <span asp-validation-for="Dui" class="field-validation-error"></span>
                            <div class="unique-feedback invalid-feedback" id="Dui-unique-feedback"></div>
                            <div class="form-text">Formato: 12345678-9 (opcional)</div>
                        </div>

                    </div>
                </div>

                @* ══════════════════════════════════════════
                   SECCIÓN 2 — DATOS DE ACCESO
                   ══════════════════════════════════════════ *@
                <div class="form-section mb-4">
                    <div class="form-section__header">
                        <span class="material-symbols-outlined form-section__icon">lock</span>
                        <h6 class="form-section__title mb-0">Datos de Acceso</h6>
                    </div>

                    <div class="row g-3 mt-1">

                        <div class="col-md-6">
                            <label asp-for="UserName" class="form-label">
                                Nombre de usuario <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left material-symbols-outlined">badge</span>
                                <input asp-for="UserName" id="UserName" class="form-control"
                                       placeholder="Ej. jperez" autocomplete="username"
                                       data-unique-check="UserName"
                                       data-unique-exclude="0"
                                       data-unique-url="/Users/CheckUnique"
                                       data-unique-msg="Este nombre de usuario ya está en uso." />
                            </div>
                            <span asp-validation-for="UserName" class="field-validation-error"></span>
                            <div class="unique-feedback invalid-feedback"
                                 id="UserName-unique-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">
                                Correo electrónico <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left material-symbols-outlined">email</span>
                                <input asp-for="Email" id="Email" class="form-control"
                                       placeholder="correo@empresa.com" autocomplete="email"
                                       data-unique-check="Email"
                                       data-unique-exclude="0"
                                       data-unique-url="/Users/CheckUnique"
                                       data-unique-msg="Este correo electrónico ya está registrado." />
                            </div>
                            <span asp-validation-for="Email" class="field-validation-error"></span>
                            <div class="unique-feedback invalid-feedback"
                                 id="Email-unique-feedback"></div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Password" class="form-label">
                                Contraseña <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--right">
                                <input asp-for="Password" id="Password" type="password"
                                       class="form-control" placeholder="Mínimo 8 caracteres"
                                       autocomplete="new-password" />
                                <button type="button"
                                        class="input-icon input-icon--right input-icon--btn"
                                        data-password-toggle="Password"
                                        tabindex="-1" aria-label="Mostrar contraseña">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="field-validation-error"></span>
                            <div id="passwordStrength" class="mt-2" style="display:none">
                                <div class="progress" style="height:4px;">
                                    <div id="strengthBar" class="progress-bar"
                                         role="progressbar" style="width:0%"></div>
                                </div>
                                <small id="strengthLabel" class="text-muted"></small>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label">
                                Confirmar contraseña <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--right">
                                <input asp-for="ConfirmPassword" id="ConfirmPassword"
                                       type="password" class="form-control"
                                       placeholder="Repite la contraseña"
                                       autocomplete="new-password" />
                                <button type="button"
                                        class="input-icon input-icon--right input-icon--btn"
                                        data-password-toggle="ConfirmPassword"
                                        tabindex="-1" aria-label="Mostrar confirmación">
                                    <span class="material-symbols-outlined">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                            <div id="confirmMatchFeedback" class="invalid-feedback"></div>
                        </div>

                    </div>
                </div>

                @* ══════════════════════════════════════════
                   SECCIÓN 3 — ROL Y ESTADO
                   (va ANTES que datos laborales para que el
                    JS detecte el rol al mostrar/ocultar)
                   ══════════════════════════════════════════ *@
                <div class="form-section mb-4">
                    <div class="form-section__header">
                        <span class="material-symbols-outlined form-section__icon">assignment_ind</span>
                        <h6 class="form-section__title mb-0">Rol y Estado</h6>
                    </div>

                    <div class="row g-3 mt-1">

                        <div class="col-md-6">
                            <label asp-for="RolId" class="form-label">
                                Rol <span class="text-danger">*</span>
                            </label>
                            <select asp-for="RolId" id="RolId"
                                    class="form-select" asp-items="ViewBag.Roles">
                                <option value="">— Seleccione un rol —</option>
                            </select>
                            <span asp-validation-for="RolId" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StatusId" class="form-label">
                                Estado <span class="text-danger">*</span>
                            </label>
                            <select asp-for="StatusId" class="form-select"
                                    asp-items="ViewBag.Statuses">
                                <option value="">— Seleccione un estado —</option>
                            </select>
                            <span asp-validation-for="StatusId" class="field-validation-error"></span>
                        </div>

                    </div>
                </div>

                @* ══════════════════════════════════════════
                   SECCIÓN 4 — DATOS LABORALES
                   Solo visible para Administrador o Vendedor
                   ══════════════════════════════════════════ *@
                <div class="form-section mb-4" id="employeeSection" style="display:none;">
                    <div class="form-section__header">
                        <span class="material-symbols-outlined form-section__icon">work</span>
                        <h6 class="form-section__title mb-0">Datos Laborales</h6>
                    </div>
                    <p class="text-muted" style="font-size:.82rem;margin-bottom:12px;">
                        El rol seleccionado requiere registrar los datos de empleado.
                    </p>

                    <div class="row g-3 mt-1">

                        <div class="col-md-6">
                            <label asp-for="EmployeeCode" class="form-label">
                                Código de empleado <span class="text-danger">*</span>
                            </label>
                            <div class="input-icon-group input-icon-group--left">
                                <span class="input-icon input-icon--left material-symbols-outlined">
                                    badge
                                </span>
                                <input asp-for="EmployeeCode" class="form-control"
                                       placeholder="Ej. EMP-001" autocomplete="off" />
                            </div>
                            <span asp-validation-for="EmployeeCode" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="HireDate" class="form-label">
                                Fecha de contratación <span class="text-danger">*</span>
                            </label>
                            <input asp-for="HireDate" type="date" class="form-control"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="HireDate" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Salary" class="form-label">
                                Salario mensual <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Salary" type="number" step="0.01" min="0.01"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Salary" class="field-validation-error"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DepartmentId" class="form-label">Departamento</label>
                            <select asp-for="DepartmentId" class="form-select"
                                    asp-items="ViewBag.DepartmentList">
                                <option value="">— Sin departamento —</option>
                            </select>
                        </div>

                    </div>
                </div>

                @* ══════════════════════════════════════════
                   ACCIONES
                   ══════════════════════════════════════════ *@
                <div class="form-actions form-actions--between">
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary" id="submitBtn">
                        <span class="material-symbols-outlined">person_add</span>
                        Crear Usuario
                    </button>
                </div>

            </form>
        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/createUser.js" asp-append-version="true"></script>

    <script>
        (function () {
            // ── Roles que requieren datos laborales ───────────────────────
            const ROLES_EMPLEADO = [
                @CreateUserModel.RolAdministradorId,   // Administrador = 1
                @CreateUserModel.RolVendedorId          // Vendedor      = 2
            ];

            const rolSelect       = document.getElementById('RolId');
            const employeeSection = document.getElementById('employeeSection');
            const empFields       = Array.from(
                employeeSection.querySelectorAll('input, select')
            );

            /**
             * Muestra u oculta la sección de datos laborales según el rol elegido.
             * Cuando se oculta, deshabilita los campos para que no sean enviados
             * en el POST y no disparen validación server-side innecesaria.
             */
            function toggleEmployeeSection() {
                const rolId      = parseInt(rolSelect.value) || 0;
                const esEmpleado = ROLES_EMPLEADO.includes(rolId);

                employeeSection.style.display = esEmpleado ? 'block' : 'none';
                empFields.forEach(f => f.disabled = !esEmpleado);
            }

            rolSelect?.addEventListener('change', toggleEmployeeSection);

            // Evaluar estado inicial (útil si el form regresa con errores del servidor)
            toggleEmployeeSection();
        }());
    </script>
}