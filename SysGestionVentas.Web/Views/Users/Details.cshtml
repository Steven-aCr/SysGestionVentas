@model SysGestionVentas.EN.User

@{
    ViewData["Title"] = $"Usuario — {Model?.UserName}";
    ViewData["BreadcrumbParent"] = "Usuarios";

    var isActive = Model?.Status?.Name?.Equals("Activo", StringComparison.OrdinalIgnoreCase) ?? false;

    var avatarInitials = (Model?.Person?.FirstName?.Length > 0 && Model?.Person?.LastName?.Length > 0)
        ? $"{Model.Person.FirstName[0]}{Model.Person.LastName[0]}".ToUpper()
        : Model?.UserName?[..1].ToUpper() ?? "?";
}

<div class="page-header">
    <div class="page-header__info">
        <h1 class="page-header__title">Detalle de Usuario</h1>
        <p class="page-header__subtitle">Información completa de la cuenta de acceso</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model?.UserId" class="btn btn--secondary">
            <span class="material-symbols-outlined">edit</span>
            Editar
        </a>
        <a asp-action="Index" class="btn btn--ghost">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="content-grid content-grid--2col" style="max-width:900px;align-items:start">

    @* ── Tarjeta de identidad ── *@
    <div class="card">
        <div class="card__header">
            <div>
                <div class="card__title">Cuenta de Acceso</div>
                <div class="card__subtitle">Credenciales del sistema</div>
            </div>
            @if (isActive)
            {
                <span class="badge badge--success">Activo</span>
            }
            else
            {
                <span class="badge badge--neutral">@(Model?.Status?.Name ?? "—")</span>
            }
        </div>
        <div class="card__body">

            @* Avatar + nombre *@
            <div style="display:flex;align-items:center;gap:var(--space-4);
                padding-bottom:var(--space-5);
                border-bottom:1px solid var(--border-color);
                margin-bottom:var(--space-5)">
                <div class="avatar avatar--xl">@avatarInitials</div>
                <div>
                    <div style="font-size:var(--text-lg);font-weight:var(--font-bold);
                        color:var(--color-neutral-900);letter-spacing:-0.02em">
                        @Model?.Person?.FullName
                    </div>
                    <div style="font-size:var(--text-sm);color:var(--color-neutral-500);margin-top:2px">
                        @Model?.Email
                    </div>
                    <span class="badge badge--primary" style="margin-top:var(--space-2)">
                        @(Model?.Rol?.Name ?? "Sin rol")
                    </span>
                </div>
            </div>

            @* Campos de detalle *@
            <dl style="display:grid;grid-template-columns:1fr 1fr;gap:var(--space-4) var(--space-6)">

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Nombre de usuario
                    </dt>
                    <dd style="font-size:var(--text-sm);color:var(--color-neutral-800);
                        font-family:var(--font-mono)">
                        @Model?.UserName
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Fecha de registro
                    </dt>
                    <dd style="font-size:var(--text-sm);color:var(--color-neutral-800)">
                        @Model?.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Estado
                    </dt>
                    <dd>
                        <div style="display:flex;align-items:center;gap:6px">
                            <span class="status-dot @(isActive ? "status-dot--active" : "status-dot--inactive")"></span>
                            <span class="text-sm">@(Model?.Status?.Name ?? "—")</span>
                        </div>
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Cambio de contraseña
                    </dt>
                   
                </div>

                @if (Model?.TempPasswordExpiry.HasValue == true)
                {
                    <div style="grid-column:1/-1">
                        <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                            text-transform:uppercase;letter-spacing:.05em;
                            color:var(--color-neutral-500);margin-bottom:4px">
                            Vencimiento contraseña temporal
                        </dt>
                        <dd style="font-size:var(--text-sm);color:var(--color-neutral-800)">
                            @Model.TempPasswordExpiry.Value.ToString("dd MMM yyyy, HH:mm")
                        </dd>
                    </div>
                }

            </dl>
        </div>
    </div>

    @* ── Tarjeta de datos personales ── *@
    <div class="card">
        <div class="card__header">
            <div>
                <div class="card__title">Datos Personales</div>
                <div class="card__subtitle">Información de la persona asociada</div>
            </div>
        </div>
        <div class="card__body">
            <dl style="display:flex;flex-direction:column;gap:var(--space-4)">

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Nombre completo
                    </dt>
                    <dd style="font-size:var(--text-sm);color:var(--color-neutral-800)">
                        @(Model?.Person?.FullName ?? "—")
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Dirección
                    </dt>
                    <dd style="font-size:var(--text-sm);color:var(--color-neutral-800)">
                        @(Model?.Person?.Adress ?? "—")
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        Teléfono
                    </dt>
                    <dd style="font-size:var(--text-sm);color:var(--color-neutral-800)">
                        @(Model?.Person?.PhoneNumber ?? "—")
                    </dd>
                </div>

                <div>
                    <dt style="font-size:var(--text-xs);font-weight:var(--font-semi);
                        text-transform:uppercase;letter-spacing:.05em;
                        color:var(--color-neutral-500);margin-bottom:4px">
                        DUI
                    </dt>
                    <dd style="font-size:var(--text-sm);color:var(--color-neutral-800);
                        font-family:var(--font-mono)">
                        @(Model?.Person?.Dui ?? "—")
                    </dd>
                </div>

            </dl>
        </div>
    </div>

</div>
