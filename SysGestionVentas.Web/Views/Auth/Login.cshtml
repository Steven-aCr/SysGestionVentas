@model SysGestionVentas.EN.ViewModels.LoginModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/forms.css" />
    <link rel="stylesheet" href="~/css/Login.css" />
</head>

<body>

    <div class="login-shell">

        <!-- BRAND -->
        <div class="login-brand">

            <div class="login-brand__logo">
                <div class="login-brand__logo-icon">
                    <span class="material-symbols-outlined">storefront</span>
                </div>
                <span class="login-brand__logo-name">SysGestionVentas</span>
            </div>

            <div class="login-brand__body">
                <h1 class="login-brand__title">
                    Gestión de ventas<br />inteligente.
                </h1>
                <p class="login-brand__subtitle">
                    Administra inventario, documentos y usuarios desde un solo lugar.
                </p>
            </div>

            <div class="login-brand__features">
                <div class="login-brand__feature">
                    <span class="material-symbols-outlined">inventory_2</span>
                    Control de inventario
                </div>
                <div class="login-brand__feature">
                    <span class="material-symbols-outlined">receipt_long</span>
                    Facturación
                </div>
                <div class="login-brand__feature">
                    <span class="material-symbols-outlined">admin_panel_settings</span>
                    Seguridad por roles
                </div>
            </div>

        </div>

        <!-- FORM -->
        <div class="login-form-panel">

            <div class="login-form-box">

                <div class="login-form-box__heading text-center">
                    <h2 class="login-form-box__title">Bienvenido</h2>
                    <p class="login-form-box__subtitle">
                        Ingresa tus credenciales
                    </p>
                </div>

                <!-- ERROR -->
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["Error"]
                    </div>
                }

                <form asp-controller="Auth" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- EMAIL -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="correo@empresa.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- PASSWORD -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>

                        <div class="input-group">
                            <input asp-for="Password"
                                   type="password"
                                   class="form-control"
                                   id="loginPassword" />

                            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword()">
                                <span class="material-symbols-outlined">visibility</span>
                            </button>
                        </div>

                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <!-- REMEMBER -->
                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <!-- BUTTON -->
                    <button type="submit" class="btn btn-primary w-100">
                        Iniciar Sesión
                    </button>

                </form>

                <p class="text-center mt-4 small text-muted">
                    &copy; @DateTime.Now.Year — SysGestionVentas
                </p>

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function togglePassword() {
        const input = document.getElementById("loginPassword");
        input.type = input.type === "password" ? "text" : "password";
        }
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")

</body>
</html>