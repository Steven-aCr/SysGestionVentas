@model SysGestionVentas.EN.ViewModels.ChangePasswordModel

@{
    ViewData["Title"] = "Cambiar Contraseña";
    ViewData["BreadcrumbParent"] = "Mi Cuenta";
}

<div class="page-header">
    <div class="page-header__info">
        <h1 class="page-header__title">Cambiar Contraseña</h1>
        <p class="page-header__subtitle">Define una nueva contraseña segura para tu cuenta</p>
    </div>
</div>

<div class="card" style="max-width:480px">
    <div class="card__body">

        <form asp-controller="Auth" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert--danger"
                 style="display:none;margin-bottom:var(--space-5)">
                <span class="material-symbols-outlined">error</span>
                <div class="alert__content"></div>
            </div>

            <div class="alert alert--info" style="margin-bottom:var(--space-6)">
                <span class="material-symbols-outlined">info</span>
                <div class="alert__content">
                    <p class="alert__text">
                        La contraseña debe tener al menos <strong>8 caracteres</strong>.
                        Una vez guardada, deberás usarla en tu próximo inicio de sesión.
                    </p>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label form-label--required"></label>
                <div class="password-group">
                    <input asp-for="NewPassword"
                           type="password"
                           class="form-control"
                           id="newPasswordInput"
                           placeholder="Mínimo 8 caracteres"
                           autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-target="newPasswordInput">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="form-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="form-label form-label--required"></label>
                <div class="password-group">
                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="form-control"
                           id="confirmNewPasswordInput"
                           placeholder="Repite la contraseña"
                           autocomplete="new-password" />
                    <button type="button"
                            class="password-toggle"
                            data-target="confirmNewPasswordInput">
                        <span class="material-symbols-outlined">visibility</span>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="form-error"></span>
            </div>

            <div class="form-actions form-actions--between">
                <a asp-controller="Home" asp-action="Index" class="btn btn--ghost">
                    Cancelar
                </a>
                <button type="submit" class="btn btn--primary">
                    <span class="material-symbols-outlined">save</span>
                    Guardar Contraseña
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
