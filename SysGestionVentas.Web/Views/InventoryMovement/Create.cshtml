@model SysGestionVentas.EN.InventoryMovement
@{
    ViewData["Title"] = "Nuevo Movimiento";
}
<h1>Nuevo Movimiento</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="InventoryId" class="control-label"></label>
                <select asp-for="InventoryId" class="form-control" asp-items="ViewBag.InventoryId">
                    <option value="">-- Seleccione un inventario --</option>
                </select>
                <span asp-validation-for="InventoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MovementType" class="control-label"></label>
                <select asp-for="MovementType" class="form-control">
                    <option value="true">Entrada</option>
                    <option value="false">Salida</option>
                </select>
                <span asp-validation-for="MovementType" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="UnitCost" class="control-label"></label>
                <input asp-for="UnitCost" class="form-control" />
                <span asp-validation-for="UnitCost" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CreatedByUser" class="control-label"></label>
                <select asp-for="CreatedByUser" class="form-control" asp-items="ViewBag.CreatedByUser">
                    <option value="">-- Seleccione un usuario --</option>
                </select>
                <span asp-validation-for="CreatedByUser" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}