@model SysGestionVentas.EN.InventoryMovement
@{
    ViewData["Title"] = "Detalles del Movimiento";
}
<h1>Detalles del Movimiento</h1>
<div>
    <h4>InventoryMovement</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Inventory)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Inventory.InventoryId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.MovementType)</dt>
        <dd class="col-sm-10">@(Model.MovementType ? "Entrada" : "Salida")</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Quantity)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.UnitCost)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.UnitCost)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CreatedAt)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.InventoryMovementId">Editar</a> |
    <a asp-action="Index">Volver al listado</a>
</div>