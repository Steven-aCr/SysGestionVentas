@model IEnumerable<SysGestionVentas.EN.InventoryMovement>
@{
    ViewData["Title"] = "Movimientos de Inventario";
}
<h1>Movimientos de Inventario</h1>
<p>
    <a asp-action="Create">Nuevo Movimiento</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Inventory)</th>
            <th>@Html.DisplayNameFor(model => model.MovementType)</th>
            <th>@Html.DisplayNameFor(model => model.Quantity)</th>
            <th>@Html.DisplayNameFor(model => model.UnitCost)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Inventory.InventoryId)</td>
                <td>@(item.MovementType)? "Entrada" : "Salida")</td>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>@Html.DisplayFor(modelItem => item.UnitCost)</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.InventoryMovementId">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.InventoryMovementId">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.InventoryMovementId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>