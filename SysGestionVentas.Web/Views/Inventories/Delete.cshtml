@model SysGestionVentas.EN.Inventory

@{
    ViewData["Title"] = "Desactivar Inventario";
    ViewData["BreadcrumbParent"] = "Inventario";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Desactivar Registro de Inventario</h1>
        <p class="page-header__subtitle">
            Esta operación es reversible. Podrá reactivar el registro desde la vista de edición.
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-6 col-md-8">

        <!-- Alerta de confirmación -->
        <div class="alert-custom alert-danger-custom mb-4"
             style="border-radius:var(--radius-lg); align-items:flex-start;">
            <span class="material-symbols-outlined" style="flex-shrink:0; margin-top:1px;">warning</span>
            <div>
                <strong>¿Está seguro?</strong> El inventario del producto
                <strong>@(Model.Product?.Name ?? $"#{Model.ProductId}")</strong>
                será marcado como inactivo.
            </div>
        </div>

        <!-- Resumen del registro -->
        <div class="card mb-4">
            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">inventory_2</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Datos del Registro
                </span>
            </div>

            <div>
                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border);
                    font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">ID</span>
                    <span style="font-weight:700;">#@Model.InventoryId</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border);
                    font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Producto</span>
                    <span style="font-weight:700;">@(Model.Product?.Name ?? $"ID #{Model.ProductId}")</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border);
                    font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Stock actual</span>
                    <span style="font-weight:600;">@Model.CurrentStock unidades</span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; border-bottom:1px solid var(--clr-border);
                    font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Precio de venta</span>
                    <span style="font-weight:800; color:var(--clr-primary);">
                        $@Model.SalePrice.ToString("F2")
                    </span>
                </div>

                <div style="display:flex; justify-content:space-between; align-items:center;
                    padding:13px 22px; font-size:.86rem;">
                    <span style="font-weight:600; color:var(--clr-text-muted);">Estado actual</span>
                    <span class="badge badge-vendedor">
                        <span class="status-dot status-dot--active"></span>
                        &nbsp;@(Model.Status?.Name ?? "Activo")
                    </span>
                </div>
            </div>
        </div>

        <!-- Formulario de confirmación -->
        <form asp-action="Delete">
            <input type="hidden" asp-for="InventoryId" />
            <div class="d-flex gap-3 align-items-center">
                <button type="submit" class="btn btn-primary"
                        style="background:var(--clr-danger);
                    border-color:var(--clr-danger);">
                    <span class="material-symbols-outlined">block</span>
                    Sí, desactivar
                </button>
                <a asp-action="Index" class="btn btn-light">
                    <span class="material-symbols-outlined">close</span>
                    Cancelar
                </a>
            </div>
        </form>

    </div>
</div>
