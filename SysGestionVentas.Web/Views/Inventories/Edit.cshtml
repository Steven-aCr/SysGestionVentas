@model SysGestionVentas.EN.Inventory

@{
    ViewData["Title"] = "Editar Inventario";
    ViewData["BreadcrumbParent"] = "Inventario";
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Editar Inventario</h1>
        <p class="page-header__subtitle">
            Producto: <strong>@(Model.Product?.Name ?? $"ID #{Model.ProductId}")</strong>
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.InventoryId" class="btn btn-light">
            <span class="material-symbols-outlined">visibility</span>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">

    <!-- ── FORMULARIO ─────────────────────────────────── -->
    <div class="col-lg-8">
        <div class="card">

            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">edit</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Actualizar Datos
                </span>
                <span class="badge badge-neutral ms-auto">
                    ID #@Model.InventoryId
                </span>
            </div>

            <div style="padding:24px;">
                <form asp-action="Edit" class="needs-validation" novalidate>

                    <div asp-validation-summary="ModelOnly"
                         class="alert-custom alert-danger-custom mb-4"
                         role="alert"
                         style="display:none;"></div>

                    <input type="hidden" asp-for="InventoryId" />

                    <!-- Sección: Producto (solo lectura) -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">package_2</span>
                            Producto Asociado
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Producto</label>
                            <select asp-for="ProductId"
                                    asp-items="ViewBag.ProductId"
                                    class="form-select"
                                    disabled
                                    style="background:var(--clr-surface-alt);
                                color:var(--clr-text-muted);
                                cursor:not-allowed;">
                            </select>
                            <input type="hidden" asp-for="ProductId" />
                            <small style="color:var(--clr-text-subtle); display:flex; align-items:center; gap:4px; margin-top:5px;">
                                <span class="material-symbols-outlined" style="font-size:13px;">lock</span>
                                El producto asociado no puede modificarse tras la creación.
                            </small>
                        </div>
                    </div>

                    <!-- Sección: Precios -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">payments</span>
                            Precios
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PurchasePrice" class="form-label">
                                    @Html.DisplayNameFor(m => m.PurchasePrice)
                                    <span style="color:var(--clr-danger);">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"
                                          style="background:var(--clr-surface-alt);
                                    border-color:var(--clr-border);
                                    font-weight:600;
                                    color:var(--clr-text-muted);">$</span>
                                    <input asp-for="PurchasePrice"
                                           class="form-control"
                                           type="number" step="0.01" min="0.01"
                                           data-type="currency"
                                           required />
                                </div>
                                <span asp-validation-for="PurchasePrice"
                                      class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="SalePrice" class="form-label">
                                    @Html.DisplayNameFor(m => m.SalePrice)
                                    <span style="color:var(--clr-danger);">*</span>
                                </label>
                                <div class="input-group">
                                    <span class="input-group-text"
                                          style="background:var(--clr-surface-alt);
                                    border-color:var(--clr-border);
                                    font-weight:600;
                                    color:var(--clr-text-muted);">$</span>
                                    <input asp-for="SalePrice"
                                           class="form-control"
                                           type="number" step="0.01" min="0.01"
                                           data-type="currency"
                                           required />
                                </div>
                                <span asp-validation-for="SalePrice"
                                      class="text-danger" style="font-size:.78rem;"></span>
                                <small style="color:var(--clr-text-subtle);">
                                    Debe ser ≥ al precio de compra.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Sección: Stock -->
                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">stacked_bar_chart</span>
                            Control de Stock
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="MinimumStock" class="form-label">
                                    @Html.DisplayNameFor(m => m.MinimumStock)
                                    <span style="color:var(--clr-danger);">*</span>
                                </label>
                                <input asp-for="MinimumStock"
                                       class="form-control"
                                       type="number" min="0"
                                       data-type="integer"
                                       required />
                                <span asp-validation-for="MinimumStock"
                                      class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CurrentStock" class="form-label">
                                    @Html.DisplayNameFor(m => m.CurrentStock)
                                    <span style="color:var(--clr-danger);">*</span>
                                </label>
                                <input asp-for="CurrentStock"
                                       class="form-control"
                                       type="number" min="0"
                                       data-type="integer"
                                       required />
                                <span asp-validation-for="CurrentStock"
                                      class="text-danger" style="font-size:.78rem;"></span>
                                <small style="color:var(--clr-text-subtle);">
                                    Use
                                    <a asp-controller="InventoryMovements"
                                       asp-action="Create"
                                       style="color:var(--clr-primary);">Registrar Movimiento</a>
                                    para ajustes auditados.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Sección: Estado -->
                    <div class="form-section" style="margin-bottom:0;">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">toggle_on</span>
                            Estado del Registro
                        </div>

                        <div>
                            <label asp-for="StatusId" class="form-label">
                                Estado <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <select asp-for="StatusId"
                                    asp-items="ViewBag.StatusId"
                                    class="form-select"
                                    required>
                                <option value="">— Seleccione un estado —</option>
                            </select>
                            <span asp-validation-for="StatusId"
                                  class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border); margin:24px 0;" />

                    <!-- Botones -->
                    <div class="d-flex align-items-center gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                        <a asp-action="Delete"
                               asp-route-id="@Model.InventoryId"
                               class="btn btn-danger-outline ms-auto"
                               style="font-size:.84rem;">
                            <span class="material-symbols-outlined">block</span>
                            Desactivar
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <!-- ── PANEL LATERAL ──────────────────────────────── -->
    <div class="col-lg-4">
        <div style="position:sticky; top:calc(var(--topbar-h) + 16px);">

            <!-- Estado actual -->
            <div class="card mb-3">
                <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                    display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined"
                          style="color:var(--clr-primary); font-size:18px;">analytics</span>
                    <span style="font-size:.88rem; font-weight:700; color:var(--clr-text);">
                        Estado Actual
                    </span>
                </div>
                <div>
                    <!-- Stock actual -->
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border);
                        font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Stock actual</span>
                        <span style="font-weight:800;
                            color:@(Model.CurrentStock <= Model.MinimumStock ? "var(--clr-danger)" : "var(--clr-success)")">
                            @Model.CurrentStock uds
                        </span>
                    </div>
                    <!-- Stock mínimo -->
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border);
                        font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Stock mínimo</span>
                        <span style="font-weight:600;">@Model.MinimumStock uds</span>
                    </div>
                    <!-- Precio compra -->
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; border-bottom:1px solid var(--clr-border);
                        font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Precio compra</span>
                        <span style="font-weight:600;">$@Model.PurchasePrice.ToString("F2")</span>
                    </div>
                    <!-- Precio venta -->
                    <div style="display:flex; justify-content:space-between; align-items:center;
                        padding:12px 18px; font-size:.84rem;">
                        <span style="color:var(--clr-text-muted); font-weight:600;">Precio venta</span>
                        <span style="font-weight:800; color:var(--clr-primary);">
                            $@Model.SalePrice.ToString("F2")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Alerta de stock bajo -->
            @if (Model.CurrentStock <= Model.MinimumStock)
            {
                <div class="alert-custom alert-warning-custom"
                     style="border-radius:var(--radius-lg); margin-bottom:12px;">
                    <span class="material-symbols-outlined" style="flex-shrink:0;">warning</span>
                    <div style="font-size:.81rem;">
                        <strong>Stock bajo:</strong> el inventario está en o por debajo del mínimo.
                        Considere registrar una entrada de stock.
                    </div>
                </div>
            }

            <!-- Fecha de registro -->
            <div class="card">
                <div style="padding:14px 18px; font-size:.82rem; color:var(--clr-text-muted);
                    display:flex; align-items:center; gap:8px;">
                    <span class="material-symbols-outlined" style="font-size:16px;">calendar_today</span>
                    Creado el <strong style="color:var(--clr-text); margin-left:4px;">
                    @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                </strong>
            </div>
        </div>

    </div>
</div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
