@model SysGestionVentas.EN.Inventory

@{
    ViewData["Title"] = "Detalle de Inventario";
    ViewData["BreadcrumbParent"] = "Inventario";

    bool stockOk = Model.CurrentStock > Model.MinimumStock;
    bool stockLow = Model.CurrentStock > 0 && Model.CurrentStock <= Model.MinimumStock;
    bool stockOut = Model.CurrentStock == 0;

    decimal margen = Model.PurchasePrice > 0
        ? Math.Round((Model.SalePrice - Model.PurchasePrice) / Model.PurchasePrice * 100, 1)
        : 0;

    double pct = Model.MinimumStock > 0
        ? Math.Min(Model.CurrentStock * 100.0 / (Model.MinimumStock * 3), 100)
        : 100;
}

<!-- Page Header -->
<div class="page-header">
    <div>
        <h1 class="page-header__title">Detalle de Inventario</h1>
        <p class="page-header__subtitle">
            @(Model.Product?.Name ?? $"Producto #{Model.ProductId}") — ID #@Model.InventoryId
        </p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn btn-primary">
            <span class="material-symbols-outlined">edit</span>
            Editar
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<!-- Alertas de stock -->
@if (stockOut)
{
    <div class="alert-custom alert-danger-custom mb-4"
         style="border-radius:var(--radius-lg); align-items:center;">
        <span class="material-symbols-outlined" style="flex-shrink:0;">inventory</span>
        <div>
            <strong>Sin stock disponible.</strong>
            Este producto no tiene unidades en inventario.
        </div>
        <a asp-controller="InventoryMovements" asp-action="Create"
               class="btn btn-primary ms-auto" style="font-size:.82rem; white-space:nowrap;">
            <span class="material-symbols-outlined">add_box</span>
            Registrar entrada
        </a>
    </div>
}
else if (stockLow)
{
    <div class="alert-custom alert-warning-custom mb-4"
         style="border-radius:var(--radius-lg); align-items:center;">
        <span class="material-symbols-outlined" style="flex-shrink:0;">warning</span>
        <strong>Stock bajo.</strong>&nbsp;
        Las existencias están en o por debajo del mínimo establecido.
    </div>
}

<div class="row g-4">

    <!-- ── INFO PRINCIPAL ─────────────────────────────── -->
    <div class="col-lg-8">

        <!-- Producto -->
        <div class="card mb-4">
            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">package_2</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Información del Producto
                </span>
            </div>
            <div style="padding:22px;">
                <dl class="row mb-0" style="font-size:.87rem;">
                    <dt class="col-sm-4" style="font-weight:600; color:var(--clr-text-muted);">
                        Producto
                    </dt>
                    <dd class="col-sm-8" style="font-weight:700;">
                        @(Model.Product?.Name ?? $"ID #{Model.ProductId}")
                    </dd>

                    <dt class="col-sm-4" style="font-weight:600; color:var(--clr-text-muted);">
                        Categoría
                    </dt>
                    <dd class="col-sm-8">
                        @(Model.Product?.Category?.Name ?? "—")
                    </dd>

                    <dt class="col-sm-4" style="font-weight:600; color:var(--clr-text-muted);">
                        Código de barras
                    </dt>
                    <dd class="col-sm-8">
                        <code style="background:var(--clr-surface-alt);
                            padding:2px 8px;
                            border-radius:var(--radius-sm);
                            font-size:.82rem;">
                            @(Model.Product?.Barcode ?? "—")
                        </code>
                    </dd>

                    <dt class="col-sm-4" style="font-weight:600; color:var(--clr-text-muted);">
                        Estado
                    </dt>
                    <dd class="col-sm-8">
                        @if (Model.StatusId == 1)
                        {
                            <span class="badge badge-vendedor">
                                <span class="status-dot status-dot--active"></span>
                                &nbsp;@(Model.Status?.Name ?? "Activo")
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-neutral">
                                <span class="status-dot status-dot--inactive"></span>
                                &nbsp;@(Model.Status?.Name ?? "Inactivo")
                            </span>
                        }
                    </dd>

                    <dt class="col-sm-4" style="font-weight:600; color:var(--clr-text-muted);">
                        Fecha de registro
                    </dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMMM yyyy, HH:mm")</dd>
                </dl>
            </div>
        </div>

        <!-- Precios y margen -->
        <div class="card mb-4">
            <div style="padding:18px 22px; border-bottom:1px solid var(--clr-border);
                display:flex; align-items:center; gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary); font-size:20px;">payments</span>
                <span style="font-size:.95rem; font-weight:700; color:var(--clr-text);">
                    Precios y Margen
                </span>
            </div>
            <div class="row g-0 text-center">
                <div class="col-4" style="padding:24px 16px; border-right:1px solid var(--clr-border);">
                    <div style="font-size:.7rem; font-weight:700; text-transform:uppercase;
                        letter-spacing:.5px; color:var(--clr-text-muted);">
                        Precio Compra
                    </div>
                    <div style="font-size:1.5rem; font-weight:800; color:var(--clr-text); margin-top:6px;">
                        $@Model.PurchasePrice.ToString("F2")
                    </div>
                </div>
                <div class="col-4" style="padding:24px 16px; border-right:1px solid var(--clr-border);">
                    <div style="font-size:.7rem; font-weight:700; text-transform:uppercase;
                        letter-spacing:.5px; color:var(--clr-text-muted);">
                        Precio Venta
                    </div>
                    <div style="font-size:1.5rem; font-weight:800; color:var(--clr-primary); margin-top:6px;">
                        $@Model.SalePrice.ToString("F2")
                    </div>
                </div>
                <div class="col-4" style="padding:24px 16px;">
                    <div style="font-size:.7rem; font-weight:700; text-transform:uppercase;
                        letter-spacing:.5px; color:var(--clr-text-muted);">
                        Margen
                    </div>
                    <div style="font-size:1.5rem; font-weight:800; color:var(--clr-success); margin-top:6px;">
                        @margen%
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones -->
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.InventoryId" class="btn btn-primary">
                <span class="material-symbols-outlined">edit</span>
                Editar Inventario
            </a>
            <a asp-controller="InventoryMovements" asp-action="Create" class="btn btn-light">
                <span class="material-symbols-outlined">add_box</span>
                Registrar Movimiento
            </a>
            <a asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">list</span>
                Ver listado
            </a>
        </div>

    </div>

    <!-- ── PANEL LATERAL ──────────────────────────────── -->
    <div class="col-lg-4">
        <div style="position:sticky; top:calc(var(--topbar-h) + 16px);">

            <!-- Stock visual -->
            <div class="card mb-3">
                <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                    display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined"
                          style="color:var(--clr-primary); font-size:18px;">stacked_bar_chart</span>
                    <span style="font-size:.88rem; font-weight:700; color:var(--clr-text);">
                        Stock
                    </span>
                </div>
                <div style="padding:22px;">

                    <div style="text-align:center; margin-bottom:16px;">
                        <span style="font-size:2.8rem; font-weight:800;
                            color:@(stockOut ? "var(--clr-danger)" : stockLow ? "var(--clr-warning)" : "var(--clr-success)");">
                            @Model.CurrentStock
                        </span>
                        <div style="font-size:.78rem; color:var(--clr-text-muted);">unidades disponibles</div>
                    </div>

                    <div class="progress mb-2" style="height:8px; border-radius:4px; background:var(--clr-border);">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width:@pct.ToString("F0")%;
                            background:@(stockOut ? "var(--clr-danger)" : stockLow ? "var(--clr-warning)" : "var(--clr-success)");
                            border-radius:4px;"
                             aria-valuenow="@Model.CurrentStock"
                             aria-valuemin="0"
                             aria-valuemax="@(Model.MinimumStock * 3)">
                        </div>
                    </div>

                    <div style="display:flex; justify-content:space-between;
                        font-size:.72rem; color:var(--clr-text-subtle);">
                        <span>0</span>
                        <span>Mín: @Model.MinimumStock</span>
                    </div>
                </div>
            </div>

            <!-- Movimientos acceso rápido -->
            <div class="card">
                <div style="padding:14px 18px; border-bottom:1px solid var(--clr-border);
                    display:flex; align-items:center; gap:10px;">
                    <span class="material-symbols-outlined"
                          style="color:var(--clr-primary); font-size:18px;">history</span>
                    <span style="font-size:.88rem; font-weight:700; color:var(--clr-text);">
                        Movimientos
                    </span>
                </div>
                <div style="padding:16px;">
                    <a asp-controller="InventoryMovements"
                           asp-action="Index"
                           class="btn btn-light"
                           style="width:100%; justify-content:center;">
                        <span class="material-symbols-outlined">history</span>
                        Ver historial completo
                    </a>
                </div>
            </div>

        </div>
    </div>

</div>
