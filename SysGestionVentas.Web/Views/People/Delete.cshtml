@model SysGestionVentas.EN.Person

@{
    ViewData["Title"] = "Desactivar Persona";
    ViewData["BreadcrumbParent"] = "Personas";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Desactivar Persona</h1>
        <p class="page-header__subtitle">El registro será marcado como inactivo.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-5 col-md-7">
        <div class="alert-custom alert-danger-custom mb-4" style="border-radius:var(--radius-lg);align-items:flex-start;">
            <span class="material-symbols-outlined" style="flex-shrink:0;margin-top:1px;">warning</span>
            <div>¿Está seguro de desactivar a <strong>@Model.FullName</strong>? El registro no será eliminado físicamente.</div>
        </div>

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:12px;">
                <div class="user-cell__avatar">@(Model.FirstName?[0].ToString().ToUpper() ?? "?")</div>
                <div>
                    <div style="font-weight:700;color:var(--clr-text);">@Model.FullName</div>
                    <div style="font-size:.78rem;color:var(--clr-text-muted);">@(Model.Dui ?? "Sin DUI")</div>
                </div>
                <span class="badge badge-vendedor ms-auto"><span class="status-dot status-dot--active"></span>&nbsp;@(Model.Status?.Name ?? "Activo")</span>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Teléfono</span>
                    <span>@(Model.PhoneNumber ?? "—")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Dirección</span>
                    <span style="color:var(--clr-text-muted);max-width:200px;text-align:right;">@(Model.Adress ?? "—")</span>
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="PersonId" />
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary" style="background:var(--clr-danger);border-color:var(--clr-danger);">
                    <span class="material-symbols-outlined">block</span>
                    Sí, desactivar
                </button>
                <a asp-action="Index" class="btn btn-light">
                    <span class="material-symbols-outlined">close</span>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
