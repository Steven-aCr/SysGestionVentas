@model SysGestionVentas.EN.Document
@{
    ViewData["Title"] = "Eliminar Documento";
}
<h1>Eliminar Documento</h1>
<h3>¿Está seguro que desea desactivar este documento?</h3>
<div>
    <h4>Document</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DocumentType)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DocumentType.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.DocNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.DocNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.IssueDate)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.IssueDate)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Person)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Person.FirstName)</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="DocumentId" />
        <input type="submit" value="Desactivar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>