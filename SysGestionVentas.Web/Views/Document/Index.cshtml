@model IEnumerable<SysGestionVentas.EN.Document>
@{
    ViewData["Title"] = "Documentos";
}
<h1>Documentos</h1>
<p>
    <a asp-action="Create">Nuevo Documento</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.DocumentType)</th>
            <th>@Html.DisplayNameFor(model => model.DocNumber)</th>
            <th>@Html.DisplayNameFor(model => model.IssueDate)</th>
            <th>@Html.DisplayNameFor(model => model.Person)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.DocumentType.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.DocNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.IssueDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Person.FirstName)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DocumentId">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.DocumentId">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.DocumentId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>