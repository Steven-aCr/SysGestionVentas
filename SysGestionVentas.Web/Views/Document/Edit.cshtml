@model SysGestionVentas.EN.Document
@{
    ViewData["Title"] = "Editar Documento";
}
<h1>Editar Documento</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="DocumentId" />

            <div class="form-group">
                <label asp-for="DocTypeId" class="control-label"></label>
                <select asp-for="DocTypeId" class="form-control" asp-items="ViewBag.DocTypeId">
                    <option value="">-- Seleccione un tipo --</option>
                </select>
                <span asp-validation-for="DocTypeId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="DocNumber" class="control-label"></label>
                <input asp-for="DocNumber" class="form-control" />
                <span asp-validation-for="DocNumber" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IssueDate" class="control-label"></label>
                <input asp-for="IssueDate" class="form-control" type="date" />
                <span asp-validation-for="IssueDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PersonId" class="control-label"></label>
                <select asp-for="PersonId" class="form-control" asp-items="ViewBag.PersonId">
                    <option value="">-- Seleccione una persona --</option>
                </select>
                <span asp-validation-for="PersonId" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}