@model SysGestionVentas.EN.Inventory
@{
    ViewData["Title"] = "Eliminar Inventario";
}
<h1>Eliminar Inventario</h1>
<h3>¿Está seguro que desea desactivar este inventario?</h3>
<div>
    <h4>Inventory</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ProductList)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PurchasePrice)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PurchasePrice)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SalePrice)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SalePrice)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.MinimumStock)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.MinimumStock)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.CurrentStock)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.CurrentStock)</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="InventoryId" />
        <input type="submit" value="Desactivar" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>