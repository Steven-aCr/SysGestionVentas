@model IEnumerable<SysGestionVentas.EN.Inventory>
@{
    ViewData["Title"] = "Inventario";
}
<h1>Inventario</h1>
<p>
    <a asp-action="Create">Nuevo Inventario</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ProductList.Name)</th>
            <th>@Html.DisplayNameFor(model => model.PurchasePrice)</th>
            <th>@Html.DisplayNameFor(model => model.SalePrice)</th>
            <th>@Html.DisplayNameFor(model => model.MinimumStock)</th>
            <th>@Html.DisplayNameFor(model => model.CurrentStock)</th>
            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.ProductList.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.PurchasePrice)</td>
                <td>@Html.DisplayFor(modelItem => item.SalePrice)</td>
                <td>@Html.DisplayFor(modelItem => item.MinimumStock)</td>
                <td>@Html.DisplayFor(modelItem => item.CurrentStock)</td>
                <td>@Html.DisplayFor(modelItem => item.CreatedAt)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.InventoryId">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.InventoryId">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.InventoryId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>