@model SysGestionVentas.EN.StatusType

@{
    ViewData["Title"] = "Nuevo Tipo de Estado";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Nuevo Tipo de Estado</h1>
        <p class="page-header__subtitle">Crea una nueva categoría para agrupar estados del sistema.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);
                display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined"
                      style="color:var(--clr-primary);font-size:20px;">category</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">
                    Datos del Tipo de Estado
                </span>
            </div>

            <div class="card-body p-4">
                <form asp-action="Create">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert-custom alert-danger-custom mb-4"
                         style="border-radius:var(--radius-md);">
                    </div>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="Name" class="form-label">
                                Nombre <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Name" class="form-control"
                                   placeholder="Ej. Estado General, Estado de Inventario…" />
                            <span asp-validation-for="Name" class="field-validation-error"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Description" class="form-label">Descripción</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Describe el propósito de este tipo de estado…"></textarea>
                            <span asp-validation-for="Description" class="field-validation-error"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input"
                                       type="checkbox" checked />
                                <label asp-for="IsActive" class="form-check-label">Activo</label>
                            </div>
                        </div>
                    </div>

                    <div class="form-actions form-actions--end mt-4">
                        <a asp-action="Index" class="btn btn-light">Cancelar</a>
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
