@model SysGestionVentas.EN.Document

@{
    ViewData["Title"] = "Nuevo Documento";
    ViewData["BreadcrumbParent"] = "Documentos";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Nuevo Documento</h1>
        <p class="page-header__subtitle">Registre un nuevo documento en el sistema.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver al listado
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">receipt_long</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Datos del Documento</span>
            </div>
            <div style="padding:24px;">
                <form asp-action="Create" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom mb-4" role="alert"></div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">description</span>
                            Identificación
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DocTypeId" class="form-label">Tipo de Documento <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="DocTypeId" asp-items="ViewBag.DocTypeId" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="DocTypeId" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DocNumber" class="form-label">Número de Documento <span style="color:var(--clr-danger)">*</span></label>
                                <input asp-for="DocNumber" class="form-control" placeholder="Ej: FAC-0001" required />
                                <span asp-validation-for="DocNumber" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IssueDate" class="form-label">Fecha de Emisión <span style="color:var(--clr-danger)">*</span></label>
                                <input asp-for="IssueDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="IssueDate" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TotalAmount" class="form-label">Monto Total</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                    <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" data-type="currency" />
                                </div>
                                <span asp-validation-for="TotalAmount" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">people</span>
                            Partes Involucradas
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PersonId" class="form-label">Persona <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="PersonId" asp-items="ViewBag.PersonId" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="PersonId" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CreatedByUser" class="form-label">Creado por <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="CreatedByUser" asp-items="ViewBag.CreatedByUser" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="CreatedByUser" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section" style="margin-bottom:0;">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">toggle_on</span>
                            Estado
                        </div>
                        <div>
                            <label asp-for="StatusId" class="form-label">Estado <span style="color:var(--clr-danger)">*</span></label>
                            <select asp-for="StatusId" asp-items="ViewBag.StatusId" class="form-select" required>
                                <option value="">— Seleccione —</option>
                            </select>
                            <span asp-validation-for="StatusId" class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border);margin:24px 0;" />

                    <div class="d-flex gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Documento
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">
            <div class="card">
                <div style="padding:14px 18px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                    <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:18px;">info</span>
                    <span style="font-size:.88rem;font-weight:700;color:var(--clr-text);">Información</span>
                </div>
                <div style="padding:18px;">
                    <ul class="list-unstyled mb-0" style="font-size:.82rem;color:var(--clr-text-muted);display:flex;flex-direction:column;gap:10px;">
                        <li class="d-flex gap-2">
                            <span class="material-symbols-outlined" style="font-size:16px;color:var(--clr-primary);flex-shrink:0;margin-top:1px;">check_circle</span>
                            El número de documento debe ser <strong>único</strong> en el sistema.
                        </li>
                        <li class="d-flex gap-2">
                            <span class="material-symbols-outlined" style="font-size:16px;color:var(--clr-primary);flex-shrink:0;margin-top:1px;">check_circle</span>
                            El monto total se puede calcular automáticamente desde los detalles.
                        </li>
                        <li class="d-flex gap-2">
                            <span class="material-symbols-outlined" style="font-size:16px;color:var(--clr-primary);flex-shrink:0;margin-top:1px;">check_circle</span>
                            Una vez emitido, no se puede cambiar el número de documento.
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
