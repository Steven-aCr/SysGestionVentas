@model SysGestionVentas.EN.Document
@{
    ViewData["Title"] = $"Editar Documento #{Model.DocNumber}";
}

<div class="page-container" style="max-width:720px">

    <div class="page-header">
        <div>
            <h1 class="page-header__title">
                <span class="material-symbols-outlined">edit</span>
                Editar Documento
            </h1>
            <p class="page-header__subtitle">
                Modificando #@Model.DocNumber · @(Model.DocumentType?.Name ?? "—")
            </p>
        </div>
        <a asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>

    <div class="card p-4">
        <form asp-action="Edit" asp-route-id="@Model.DocumentId" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DocumentId" />
            <input type="hidden" asp-for="DocNumber" />
            <input type="hidden" asp-for="DocTypeId" />
            <input type="hidden" asp-for="CreatedByUser" />

            <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom mb-3">
            </div>

            @* Información solo lectura *@
            <div class="card p-3 mb-3" style="background:var(--clr-surface-alt)">
                <div class="d-flex gap-4 flex-wrap" style="font-size:.85rem">
                    <div>
                        <span style="color:var(--clr-text-muted)">Número:</span>
                        <strong class="ms-1">@Model.DocNumber</strong>
                    </div>
                    <div>
                        <span style="color:var(--clr-text-muted)">Tipo:</span>
                        <strong class="ms-1">@(Model.DocumentType?.Name ?? "—")</strong>
                    </div>
                    <div>
                        <span style="color:var(--clr-text-muted)">Creado por:</span>
                        <strong class="ms-1">@(Model.CreatedBy?.UserName ?? "—")</strong>
                    </div>
                </div>
            </div>

            @* Fecha y persona *@
            <div class="form-section">
                <div class="form-section__header">
                    <span class="material-symbols-outlined form-section__icon">person</span>
                    <span class="form-section__title">Cliente y Fecha</span>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="PersonId" class="form-label">Cliente / Persona</label>
                        <select asp-for="PersonId" asp-items="ViewBag.PersonList"
                                class="form-select">
                            <option value="">— Seleccione —</option>
                        </select>
                        <span asp-validation-for="PersonId" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="IssueDate" class="form-label">Fecha de Emisión</label>
                        <input asp-for="IssueDate" class="form-control" type="date" />
                        <span asp-validation-for="IssueDate" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @* Estado *@
            <div class="form-section">
                <div class="form-section__header">
                    <span class="material-symbols-outlined form-section__icon">toggle_on</span>
                    <span class="form-section__title">Estado</span>
                </div>
                <div class="col-12 col-md-6">
                    <label asp-for="StatusId" class="form-label">Estado del Documento</label>
                    <select asp-for="StatusId" asp-items="ViewBag.StatusList"
                            class="form-select">
                        <option value="">— Seleccione —</option>
                    </select>
                    <span asp-validation-for="StatusId" class="text-danger"></span>
                </div>
            </div>

            @* Total (solo lectura visual) *@
            <div class="row g-3 mb-3">
                <div class="col-12 col-md-4">
                    <label asp-for="TotalAmount" class="form-label">Total del Documento</label>
                    <input asp-for="TotalAmount" class="form-control"
                           type="number" step="0.01" readonly
                           style="background:var(--clr-surface-alt)" />
                    <small style="color:var(--clr-text-subtle);font-size:.75rem">
                        Se recalcula automáticamente al modificar líneas.
                    </small>
                </div>
            </div>

            <div class="form-actions form-actions--end">
                <a asp-action="Details" asp-route-id="@Model.DocumentId"
                   class="btn btn-light">
                    Cancelar
                </a>
                <button type="submit" class="btn btn-primary" id="submitBtn">
                    <span class="material-symbols-outlined">save</span>
                    Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
