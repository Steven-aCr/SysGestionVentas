@model SysGestionVentas.EN.Document

@{
    ViewData["Title"] = "Editar Documento";
    ViewData["BreadcrumbParent"] = "Documentos";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Editar Documento</h1>
        <p class="page-header__subtitle">N° <strong>@Model.DocNumber</strong></p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Details" asp-route-id="@Model.DocumentId" class="btn btn-light">
            <span class="material-symbols-outlined">visibility</span>
            Ver detalle
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">edit</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Actualizar Datos</span>
                <span class="badge badge-neutral ms-auto">ID #@Model.DocumentId</span>
            </div>
            <div style="padding:24px;">
                <form asp-action="Edit" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom mb-4" role="alert"></div>
                    <input type="hidden" asp-for="DocumentId" />

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">description</span>
                            Identificación
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DocTypeId" class="form-label">Tipo de Documento <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="DocTypeId" asp-items="ViewBag.DocTypeId" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="DocTypeId" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Número de Documento</label>
                                <input value="@Model.DocNumber" class="form-control" disabled style="background:var(--clr-surface-alt);cursor:not-allowed;" />
                                <input type="hidden" asp-for="DocNumber" />
                                <small style="color:var(--clr-text-subtle);display:flex;align-items:center;gap:4px;margin-top:5px;">
                                    <span class="material-symbols-outlined" style="font-size:13px;">lock</span>
                                    No modificable tras la emisión.
                                </small>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IssueDate" class="form-label">Fecha de Emisión <span style="color:var(--clr-danger)">*</span></label>
                                <input asp-for="IssueDate" class="form-control" type="datetime-local" required />
                                <span asp-validation-for="IssueDate" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TotalAmount" class="form-label">Monto Total</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                    <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" min="0" data-type="currency" />
                                </div>
                                <span asp-validation-for="TotalAmount" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">people</span>
                            Partes Involucradas
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="PersonId" class="form-label">Persona <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="PersonId" asp-items="ViewBag.PersonId" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="PersonId" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Creado por</label>
                                <select asp-for="CreatedByUser" asp-items="ViewBag.CreatedByUser" class="form-select" disabled style="background:var(--clr-surface-alt);cursor:not-allowed;">
                                </select>
                                <input type="hidden" asp-for="CreatedByUser" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section" style="margin-bottom:0;">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">toggle_on</span>
                            Estado
                        </div>
                        <div>
                            <label asp-for="StatusId" class="form-label">Estado <span style="color:var(--clr-danger)">*</span></label>
                            <select asp-for="StatusId" asp-items="ViewBag.StatusId" class="form-select" required>
                                <option value="">— Seleccione —</option>
                            </select>
                            <span asp-validation-for="StatusId" class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border);margin:24px 0;" />

                    <div class="d-flex gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Cambios
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.DocumentId" class="btn btn-danger-outline ms-auto" style="font-size:.84rem;">
                            <span class="material-symbols-outlined">block</span>
                            Anular
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">
            <div class="card">
                <div style="padding:14px 18px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                    <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:18px;">analytics</span>
                    <span style="font-size:.88rem;font-weight:700;color:var(--clr-text);">Resumen</span>
                </div>
                <div>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-bottom:1px solid var(--clr-border);font-size:.84rem;">
                        <span style="color:var(--clr-text-muted);font-weight:600;">N° Documento</span>
                        <code style="background:var(--clr-surface-alt);padding:2px 8px;border-radius:var(--radius-sm);font-size:.8rem;">@Model.DocNumber</code>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-bottom:1px solid var(--clr-border);font-size:.84rem;">
                        <span style="color:var(--clr-text-muted);font-weight:600;">Tipo</span>
                        <span style="font-weight:600;">@(Model.DocumentType?.Name ?? "—")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 18px;border-bottom:1px solid var(--clr-border);font-size:.84rem;">
                        <span style="color:var(--clr-text-muted);font-weight:600;">Monto actual</span>
                        <span style="font-weight:800;color:var(--clr-primary);">$@Model.TotalAmount.ToString("F2")</span>
                    </div>
                    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px 18px;font-size:.84rem;">
                        <span style="color:var(--clr-text-muted);font-weight:600;">Estado</span>
                        <span class="badge badge-vendedor">@(Model.Status?.Name ?? "—")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
