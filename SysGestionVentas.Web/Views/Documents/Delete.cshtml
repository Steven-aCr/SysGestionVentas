@model SysGestionVentas.EN.Document

@{
    ViewData["Title"] = "Anular Documento";
    ViewData["BreadcrumbParent"] = "Documentos";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Anular Documento</h1>
        <p class="page-header__subtitle">Esta acción cambiará el estado del documento a Anulado.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="alert-custom alert-danger-custom mb-4" style="border-radius:var(--radius-lg);align-items:flex-start;">
            <span class="material-symbols-outlined" style="flex-shrink:0;margin-top:1px;">warning</span>
            <div>
                <strong>¿Está seguro?</strong> El documento N° <strong>@Model.DocNumber</strong> será marcado como anulado y no podrá usarse en nuevas transacciones.
            </div>
        </div>

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">receipt_long</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Datos del Documento</span>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Tipo</span>
                    <span style="font-weight:700;">@(Model.DocumentType?.Name ?? "—")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Número</span>
                    <code style="background:var(--clr-surface-alt);padding:2px 8px;border-radius:var(--radius-sm);">@Model.DocNumber</code>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Fecha de Emisión</span>
                    <span>@Model.IssueDate.ToString("dd/MM/yyyy")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Monto Total</span>
                    <span style="font-weight:800;color:var(--clr-primary);">$@Model.TotalAmount.ToString("F2")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Estado actual</span>
                    <span class="badge badge-vendedor"><span class="status-dot status-dot--active"></span>&nbsp;@(Model.Status?.Name ?? "—")</span>
                </div>
            </div>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="DocumentId" />
            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary" style="background:var(--clr-danger);border-color:var(--clr-danger);">
                    <span class="material-symbols-outlined">block</span>
                    Sí, anular documento
                </button>
                <a asp-action="Index" class="btn btn-light">
                    <span class="material-symbols-outlined">close</span>
                    Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
