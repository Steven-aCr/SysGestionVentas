@model SysGestionVentas.EN.Pagination.PagedResult<SysGestionVentas.EN.Document>

@{
    ViewData["Title"] = "Documentos";
    ViewData["BreadcrumbParent"] = "Ventas";
}

<div class="page-content">

    <!-- Header -->
    <div class="page-header">
        <div>
            <h1 class="page-header__title">Documentos</h1>
            <p class="page-header__subtitle">Gestión de comprobantes y transacciones</p>
        </div>
        <div class="page-header__actions">
            <a asp-action="Create" class="btn btn-primary">
                <span class="material-symbols-outlined">add</span>
                Nuevo Documento
            </a>
        </div>
    </div>

    <!-- Card -->
    <div class="table-card">

        <!-- Toolbar -->
        <div class="table-toolbar">
            <div class="search-box">
                <span class="material-symbols-outlined" style="font-size:18px; color:var(--clr-text-subtle);">search</span>
                <input type="text"
                       class="table-search__input"
                       data-table="documentTable"
                       data-count="filteredCount"
                       placeholder="Buscar por número, cliente o tipo..." />
            </div>

            <span style="font-size:.8rem; color:var(--clr-text-muted);" id="recordCount">
                @(Model?.Items?.Count() ?? 0) registro(s)
            </span>
        </div>

        <!-- Table -->
        <div class="table-responsive">
            <table class="table" id="documentTable">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Número</th>
                        <th>Cliente</th>
                        <th>Total</th>
                        <th>Fecha</th>
                        <th>Usuario</th>
                        <th>Estado</th>
                        <th style="text-align:right;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-state__icon">
                                        <span class="material-symbols-outlined">receipt_long</span>
                                    </div>
                                    <div class="empty-state__title">Sin resultados</div>
                                    <p class="empty-state__text">
                                        No hay documentos registrados
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            var tipo = item.DocumentType?.Name ?? "—";
                            var cliente = item.Person?.FullName ?? "—";
                            var usuario = item.CreatedBy?.Email ?? "—";
                            var estado = item.Status?.Name ?? "—";

                            <tr>
                                <td>
                                    <span class="badge badge-neutral">@tipo</span>
                                </td>

                                <td>
                                    <strong>@item.DocNumber</strong>
                                </td>

                                <td>@cliente</td>

                                <td>
                                    <strong>$@item.TotalAmount.ToString("0.00")</strong>
                                </td>

                                <td style="color:var(--clr-text-muted);">
                                    @item.IssueDate.ToString("dd/MM/yyyy")
                                </td>

                                <td style="color:var(--clr-text-muted);">
                                    @usuario
                                </td>

                                <td>
                                    <div class="status">
                                        <span class="status-dot @(estado == "Activo" ? "status-dot--active" : "status-dot--inactive")"></span>
                                        <span>@estado</span>
                                    </div>
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@item.DocumentId"
                                               class="btn btn-icon" title="Ver detalle">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.DocumentId"
                                               class="btn btn-icon" title="Editar">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.DocumentId"
                                               class="btn btn-icon btn-danger-outline" title="Eliminar">
                                            <span class="material-symbols-outlined">delete</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="table-footer">
            <span id="filteredCount">
                Mostrando @(Model?.Items?.Count() ?? 0) documento(s)
            </span>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/table-search.js" asp-append-version="true"></script>
}