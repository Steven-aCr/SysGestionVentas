@model SysGestionVentas.EN.Pagination.PagedResult<SysGestionVentas.EN.Document>
@{
    ViewData["Title"] = "Documentos";
    var busqueda    = ViewBag.Busqueda as string;
    var statusId    = (int)(ViewBag.StatusId   ?? 0);
    var docTypeId   = (int)(ViewBag.DocTypeId  ?? 0);
    var currentPage = Model?.CurrentPage ?? 1;
    var totalPages  = Model?.TotalPages  ?? 1;
}

<div class="page-container">

    @* ── Page header ───────────────────────────────────────── *@
    <div class="page-header">
        <div>
            <h1 class="page-header__title">
                <span class="material-symbols-outlined">receipt_long</span>
                Documentos
            </h1>
            <p class="page-header__subtitle">
                Gestión de documentos de ventas y compras del sistema.
            </p>
        </div>
        <div class="page-header__actions">
            <a asp-action="Create" class="btn btn-primary">
                <span class="material-symbols-outlined">add</span>
                Nuevo Documento
            </a>
        </div>
    </div>

    @* ── TempData alerts ───────────────────────────────────── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert-custom alert-success-custom mb-3">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-danger-custom mb-3">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    @* ── Tabla principal ───────────────────────────────────── *@
    <div class="table-card">

        @* Toolbar: búsqueda + filtros *@
        <form method="get" asp-action="Index" id="filterForm">
            <div class="table-toolbar">
                <div class="search-box">
                    <span class="material-symbols-outlined" style="color:var(--clr-text-subtle);font-size:18px">
                        search
                    </span>
                    <input type="text"
                           name="busqueda"
                           value="@busqueda"
                           placeholder="Buscar por número de documento…"
                           oninput="document.getElementById('filterForm').submit()" />
                    <input type="hidden" name="statusId"  value="@statusId" />
                    <input type="hidden" name="docTypeId" value="@docTypeId" />
                    <input type="hidden" name="page"      value="1" />
                </div>

                <div class="d-flex gap-2 flex-wrap align-items-center">
                    @* Filtro tipo de documento *@
                    <select name="docTypeId"
                            class="form-select form-select-sm"
                            style="min-width:170px"
                            onchange="this.form.submit()">
                        <option value="0">Todos los tipos</option>
                        @if (ViewBag.DocTypeList is SelectList dtList)
                        {
                            foreach (var item in dtList)
                            {
                                <option value="@item.Value"
                                        selected="@(item.Value == docTypeId.ToString() ? "selected" : null)">
                                    @item.Text
                                </option>
                            }
                        }
                    </select>

                    @* Filtro estado *@
                    <select name="statusId"
                            class="form-select form-select-sm"
                            style="min-width:140px"
                            onchange="this.form.submit()">
                        <option value="0">Todos los estados</option>
                        @if (ViewBag.StatusList is SelectList stList)
                        {
                            foreach (var item in stList)
                            {
                                <option value="@item.Value"
                                        selected="@(item.Value == statusId.ToString() ? "selected" : null)">
                                    @item.Text
                                </option>
                            }
                        }
                    </select>

                    @if (!string.IsNullOrWhiteSpace(busqueda) || statusId > 0 || docTypeId > 0)
                    {
                        <a asp-action="Index" class="btn btn-light btn-sm">
                            <span class="material-symbols-outlined" style="font-size:16px">
                                filter_alt_off
                            </span>
                            Limpiar
                        </a>
                    }
                </div>
            </div>
        </form>

        @* Tabla *@
        <div class="table-responsive">
            <table class="table" id="documentsTable">
                <thead>
                    <tr>
                        <th>Número</th>
                        <th>Tipo</th>
                        <th>Fecha Emisión</th>
                        <th>Cliente / Persona</th>
                        <th>Creado por</th>
                        <th class="text-end">Total</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <div class="empty-state__icon">
                                        <span class="material-symbols-outlined">
                                            receipt_long
                                        </span>
                                    </div>
                                    <p class="empty-state__title">Sin documentos</p>
                                    <p class="empty-state__text">
                                        No se encontraron documentos con los filtros actuales.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var doc in Model.Items)
                        {
                            var isActive = doc.Status?.Name == "Activo" || doc.Status?.Name == "Emitido";
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@doc.DocumentId"
                                       style="font-weight:600;color:var(--clr-primary);text-decoration:none">
                                        @doc.DocNumber
                                    </a>
                                </td>
                                <td>
                                    <span class="badge badge-neutral">
                                        @(doc.DocumentType?.Name ?? "—")
                                    </span>
                                </td>
                                <td>@doc.IssueDate.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-cell__avatar" style="width:32px;height:32px;font-size:.7rem">
                                            @(doc.Person?.FirstName?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="user-cell__name">
                                                @(doc.Person?.FullName ?? "—")
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td style="color:var(--clr-text-muted);font-size:.825rem">
                                    @(doc.CreatedBy?.UserName ?? "—")
                                </td>
                                <td class="text-end" style="font-weight:600">
                                    $@doc.TotalAmount.ToString("N2")
                                </td>
                                <td>
                                    <span class="status">
                                        <span class="status-dot @(isActive ? "status-dot--active" : "status-dot--inactive")">
                                        </span>
                                        @(doc.Status?.Name ?? "—")
                                    </span>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@doc.DocumentId"
                                           class="btn-icon" title="Ver detalle"
                                           data-bs-toggle="tooltip">
                                            <span class="material-symbols-outlined" style="font-size:18px">
                                                visibility
                                            </span>
                                        </a>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-action="Delete" asp-route-id="@doc.DocumentId"
                                               class="btn-icon btn-danger-outline" title="Anular"
                                               data-bs-toggle="tooltip">
                                                <span class="material-symbols-outlined" style="font-size:18px">
                                                    cancel
                                                </span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* Footer: paginación *@
        @if (Model != null && Model.TotalCount > 0)
        {
            <div class="table-footer">
                <span>
                    Mostrando @Model.FirstItemIndex–@Model.LastItemIndex
                    de @Model.TotalCount registros
                </span>

                <nav aria-label="Paginación de documentos">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage - 1)"
                               asp-route-busqueda="@busqueda"
                               asp-route-statusId="@statusId"
                               asp-route-docTypeId="@docTypeId">
                                ‹
                            </a>
                        </li>

                        @for (int p = Math.Max(1, currentPage - 2);
                              p <= Math.Min(totalPages, currentPage + 2); p++)
                        {
                            <li class="page-item @(p == currentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@p"
                                   asp-route-busqueda="@busqueda"
                                   asp-route-statusId="@statusId"
                                   asp-route-docTypeId="@docTypeId">
                                    @p
                                </a>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(currentPage + 1)"
                               asp-route-busqueda="@busqueda"
                               asp-route-statusId="@statusId"
                               asp-route-docTypeId="@docTypeId">
                                ›
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@using Microsoft.AspNetCore.Mvc.Rendering
