@model SysGestionVentas.EN.Document
@{
    ViewData["Title"] = $"Documento #{Model.DocNumber}";
    var detalles = ViewBag.Detalles as List<SysGestionVentas.EN.DocumentDetail> ?? new();
    var isAnulado = Model.Status?.Name == "Anulado";
    var isEditable = !isAnulado;
}

<div class="page-container">

    @* ── Alerts ────────────────────────────────────────────── *@
    @if (TempData["Success"] != null)
    {
        <div class="alert-custom alert-success-custom mb-3">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-danger-custom mb-3">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    @* ── Page header ───────────────────────────────────────── *@
    <div class="page-header">
        <div>
            <h1 class="page-header__title">
                <span class="material-symbols-outlined">receipt_long</span>
                Documento #@Model.DocNumber
            </h1>
            <p class="page-header__subtitle">
                @(Model.DocumentType?.Name ?? "—") ·
                Emitido el @Model.IssueDate.ToString("dd/MM/yyyy")
            </p>
        </div>
        <div class="page-header__actions">
            @if (User.IsInRole("Administrador") && isEditable)
            {
                <a asp-action="Delete" asp-route-id="@Model.DocumentId"
                       class="btn btn-light btn-danger-outline">
                    <span class="material-symbols-outlined">cancel</span>
                    Anular
                </a>
            }
            <a asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">arrow_back</span>
                Volver
            </a>
        </div>
    </div>

    @* ── Datos del documento ───────────────────────────────── *@
    <div class="row g-3 mb-4">

        @* Tarjeta: info principal *@
        <div class="col-12 col-md-6">
            <div class="card p-4 h-100">
                <div class="form-section__header mb-3">
                    <span class="material-symbols-outlined form-section__icon">info</span>
                    <span class="form-section__title">Información del Documento</span>
                </div>
                <dl class="row mb-0" style="font-size:.875rem;row-gap:.5rem">
                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Número
                    </dt>
                    <dd class="col-7 fw-600">@Model.DocNumber</dd>

                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Tipo
                    </dt>
                    <dd class="col-7">
                        <span class="badge badge-neutral">
                            @(Model.DocumentType?.Name ?? "—")
                        </span>
                    </dd>

                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Fecha emisión
                    </dt>
                    <dd class="col-7">@Model.IssueDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Creado por
                    </dt>
                    <dd class="col-7">@(Model.CreatedBy?.UserName ?? "—")</dd>

                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Estado
                    </dt>
                    <dd class="col-7">
                        <span class="status">
                            <span class="status-dot @(isAnulado ? "status-dot--inactive" : "status-dot--active")">
                            </span>
                            @(Model.Status?.Name ?? "—")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>

        @* Tarjeta: cliente + totales *@
        <div class="col-12 col-md-6">
            <div class="card p-4 h-100">
                <div class="form-section__header mb-3">
                    <span class="material-symbols-outlined form-section__icon">person</span>
                    <span class="form-section__title">Cliente y Totales</span>
                </div>
                <dl class="row mb-0" style="font-size:.875rem;row-gap:.5rem">
                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Cliente
                    </dt>
                    <dd class="col-7 fw-600">@(Model.Person?.FullName ?? "—")</dd>

                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        Teléfono
                    </dt>
                    <dd class="col-7">@(Model.Person?.PhoneNumber ?? "—")</dd>

                    <dt class="col-5" style="color:var(--clr-text-muted);font-weight:500">
                        DUI
                    </dt>
                    <dd class="col-7">@(Model.Person?.Dui ?? "—")</dd>
                </dl>

                @* Resumen de importes *@
                <div style="border-top:1px solid var(--clr-border);margin-top:1rem;padding-top:1rem">
                    @{
                        var subtotalDoc = detalles.Sum(d => d.Subtotal);
                        var taxDoc = detalles.Sum(d => d.TaxAmount);
                    }
                    <div class="d-flex justify-content-between mb-1"
                         style="font-size:.85rem;color:var(--clr-text-muted)">
                        <span>Subtotal</span>
                        <span>$@subtotalDoc.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1"
                         style="font-size:.85rem;color:var(--clr-text-muted)">
                        <span>IVA</span>
                        <span>$@taxDoc.ToString("N2")</span>
                    </div>
                    <div class="d-flex justify-content-between"
                         style="font-weight:700;font-size:1.05rem;color:var(--clr-primary)">
                        <span>TOTAL</span>
                        <span>$@Model.TotalAmount.ToString("N2")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Tabs: Líneas / Movimientos ────────────────────────── *@
    <div class="tabs mb-0">
        <a href="#tab-lineas" class="tabs__link active" id="tab-lineas-btn"
               onclick="switchTab('lineas'); return false;">
            <span class="material-symbols-outlined" style="font-size:18px">list_alt</span>
            Líneas de detalle
            <span class="tabs__badge">@detalles.Count</span>
        </a>
        <a href="#tab-movimientos" class="tabs__link" id="tab-movimientos-btn"
               onclick="switchTab('movimientos'); return false;">
            <span class="material-symbols-outlined" style="font-size:18px">
                compare_arrows
            </span>
            Movimientos de inventario
        </a>
    </div>

    @* ── TAB: Líneas de detalle ────────────────────────────── *@
    <div id="tab-lineas" class="tab-panel table-card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Producto</th>
                        <th class="text-end">Cant.</th>
                        <th class="text-end">Precio unit.</th>
                        <th class="text-end">Descuento</th>
                        <th class="text-end">Subtotal</th>
                        <th class="text-end">IVA</th>
                        <th class="text-end">Total</th>
                        <th>Notas</th>
                        @if (isEditable)
                        {
                            <th class="text-end">Acciones</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!detalles.Any())
                    {
                        <tr>
                            <td colspan="@(isEditable ? 10 : 9)">
                                <div class="empty-state" style="padding:40px">
                                    <div class="empty-state__icon">
                                        <span class="material-symbols-outlined">
                                            list_alt
                                        </span>
                                    </div>
                                    <p class="empty-state__title">Sin líneas</p>
                                    <p class="empty-state__text">
                                        Este documento aún no tiene productos agregados.
                                    </p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 1;
                        foreach (var det in detalles)
                        {
                            <tr>
                                <td style="color:var(--clr-text-muted);font-size:.8rem">@(i++)</td>
                                <td style="font-weight:600">
                                    @(det.Product?.Name ?? $"Producto #{det.ProductId}")
                                </td>
                                <td class="text-end">@det.Quantity</td>
                                <td class="text-end">$@det.UnitPrice.ToString("N2")</td>
                                <td class="text-end">$@det.DiscountAmount.ToString("N2")</td>
                                <td class="text-end">$@det.Subtotal.ToString("N2")</td>
                                <td class="text-end" style="color:var(--clr-text-muted)">
                                    $@det.TaxAmount.ToString("N2")
                                </td>
                                <td class="text-end fw-600" style="color:var(--clr-primary)">
                                    $@det.TotalAmount.ToString("N2")
                                </td>
                                <td style="font-size:.8rem;color:var(--clr-text-muted)">
                                    @(det.Notes ?? "—")
                                </td>
                                @if (isEditable)
                                {
                                    <td>
                                        <div class="table-actions">
                                            <a asp-controller="DocumentDetails"
                                                   asp-action="Details"
                                                   asp-route-id="@det.DocDetailId"
                                                   class="btn-icon" title="Ver">
                                                <span class="material-symbols-outlined"
                                                      style="font-size:18px">
                                                    visibility
                                                </span>
                                            </a>
                                            <a asp-controller="DocumentDetails"
                                                   asp-action="Delete"
                                                   asp-route-id="@det.DocDetailId"
                                                   class="btn-icon btn-danger-outline" title="Eliminar">
                                                <span class="material-symbols-outlined"
                                                      style="font-size:18px">
                                                    delete
                                                </span>
                                            </a>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ── TAB: Movimientos de inventario ────────────────────── *@
    <div id="tab-movimientos" class="tab-panel table-card" style="display:none">
        <div class="table-toolbar">
            <span style="font-size:.85rem;color:var(--clr-text-muted)">
                Movimientos de inventario generados por este documento.
            </span>
            <button class="btn btn-light btn-sm" onclick="cargarMovimientos(@Model.DocumentId)">
                <span class="material-symbols-outlined" style="font-size:16px">refresh</span>
                Actualizar
            </button>
        </div>
        <div class="table-responsive">
            <table class="table" id="movimientosTable">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Producto</th>
                        <th class="text-end">Cantidad</th>
                        <th class="text-end">Costo unit.</th>
                        <th>Usuario</th>
                        <th>Notas</th>
                    </tr>
                </thead>
                <tbody id="movimientosBody">
                    <tr>
                        <td colspan="6" class="text-center"
                            style="padding:30px;color:var(--clr-text-muted)">
                            <span class="material-symbols-outlined"
                                  style="font-size:28px;display:block;margin-bottom:8px;opacity:.4">
                                compare_arrows
                            </span>
                            Haz clic en "Actualizar" para cargar los movimientos.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>