@model SysGestionVentas.EN.Document

@{
    ViewData["Title"] = "Detalle de Documento";
    ViewData["BreadcrumbParent"] = "Documentos";
    var statusName = Model.Status?.Name ?? "—";
    var statusClass = statusName switch
    {
        "Pagado" => "badge-vendedor",
        "Emitido" => "badge-admin",
        "Pendiente" => "badge-cliente",
        "Anulado" => "badge-neutral",
        _ => "badge-neutral"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Detalle de Documento</h1>
        <p class="page-header__subtitle">N° <strong>@Model.DocNumber</strong> — ID #@Model.DocumentId</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Edit" asp-route-id="@Model.DocumentId" class="btn btn-primary">
            <span class="material-symbols-outlined">edit</span>
            Editar
        </a>
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">receipt_long</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Información del Documento</span>
                <span class="badge @statusClass ms-auto">@statusName</span>
            </div>
            <div style="padding:22px;">
                <dl class="row mb-0" style="font-size:.87rem;">
                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Tipo de Documento</dt>
                    <dd class="col-sm-8" style="font-weight:700;">@(Model.DocumentType?.Name ?? "—")</dd>

                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Número</dt>
                    <dd class="col-sm-8">
                        <code style="background:var(--clr-surface-alt);padding:2px 8px;border-radius:var(--radius-sm);font-size:.82rem;">@Model.DocNumber</code>
                    </dd>

                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Fecha de Emisión</dt>
                    <dd class="col-sm-8">@Model.IssueDate.ToString("dd MMMM yyyy, HH:mm")</dd>

                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Monto Total</dt>
                    <dd class="col-sm-8" style="font-size:1.1rem;font-weight:800;color:var(--clr-primary);">$@Model.TotalAmount.ToString("F2")</dd>

                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Persona</dt>
                    <dd class="col-sm-8">@(Model.Person?.FullName ?? Model.Person?.Adress ?? "—")</dd>

                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Creado por</dt>
                    <dd class="col-sm-8">@(Model.CreatedBy?.Email ?? "—")</dd>

                    <dt class="col-sm-4" style="font-weight:600;color:var(--clr-text-muted);">Estado</dt>
                    <dd class="col-sm-8"><span class="badge @statusClass">@statusName</span></dd>
                </dl>
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Edit" asp-route-id="@Model.DocumentId" class="btn btn-primary">
                <span class="material-symbols-outlined">edit</span>
                Editar Documento
            </a>
            <a asp-controller="DocumentDetails" asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">list</span>
                Ver Detalles
            </a>
            <a asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">arrow_back</span>
                Volver al listado
            </a>
        </div>
    </div>

    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">
            <div class="card">
                <div style="padding:14px 18px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                    <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:18px;">payments</span>
                    <span style="font-size:.88rem;font-weight:700;color:var(--clr-text);">Monto</span>
                </div>
                <div style="padding:24px;text-align:center;">
                    <div style="font-size:2rem;font-weight:800;color:var(--clr-primary);">$@Model.TotalAmount.ToString("F2")</div>
                    <div style="font-size:.78rem;color:var(--clr-text-muted);margin-top:4px;">Total del documento</div>
                </div>
            </div>
        </div>
    </div>
</div>
