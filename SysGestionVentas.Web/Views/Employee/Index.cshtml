@model IEnumerable<SysGestionVentas.EN.Employee>

@{
    ViewData["Title"] = "Employees";
}

<h1>Employees</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Employee</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Employee Code</th>
            <th>Hire Date</th>
            <th>Salary</th>
            <th>Department ID</th>
            <th>User ID</th>
            <th>Person ID</th>
            <th>Status ID</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model)
        {
            <tr>
                <td>@employee.EmployeeCode</td>
                <td>@employee.HireDate.ToShortDateString()</td>
                <td>@employee.Salary.ToString("C")</td>
                <td>@employee.DepartmentId</td>
                <td>@employee.UserId</td>
                <td>@employee.PersonId</td>
                <td>@employee.StatusId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@employee.EmployeeId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@employee.EmployeeId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@employee.EmployeeId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
