@model SysGestionVentas.EN.Pagination.PagedResult<SysGestionVentas.EN.Discount>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Descuentos";
    ViewData["BreadcrumbParent"] = "Catálogo";

    var busqueda = ViewBag.Busqueda as string ?? string.Empty;
    var statusId = (int)(ViewBag.StatusId ?? 0);
    int page = Model.CurrentPage;
    int totalPages = Model.TotalPages;
    var hoy = DateTime.Today;
}

<div class="page-content">

    <div class="page-header">
        <div>
            <h1 class="page-header__title">
                <span class="material-symbols-outlined">sell</span>
                Descuentos
            </h1>
            <p class="page-header__subtitle">Gestión de promociones y descuentos aplicados a productos</p>
        </div>
        <div class="page-header__actions">
            <a asp-action="Create" class="btn btn-primary">
                <span class="material-symbols-outlined">add</span>
                Nuevo Descuento
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-custom alert-success-custom mb-3">
            <span class="material-symbols-outlined">check_circle</span>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-danger-custom mb-3">
            <span class="material-symbols-outlined">error</span>
            @TempData["Error"]
        </div>
    }

    <div class="table-card">

        <div class="table-toolbar">
            <form asp-action="Index" method="get"
                  style="display:flex; align-items:center; gap:.75rem; flex-wrap:wrap;">

                <div class="search-box">
                    <span class="material-symbols-outlined" style="font-size:18px; color:var(--clr-text-subtle);">search</span>
                    <input type="text" name="busqueda" value="@busqueda"
                           placeholder="Nombre del descuento…" autocomplete="off" />
                </div>

                <select name="statusId" class="form-select" style="min-width:150px; font-size:.84rem;">
                    <option value="0">— Todos los estados —</option>
                    @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.StatusList)
                    {
                        <option value="@item.Value" selected="@item.Selected">@item.Text</option>
                    }
                </select>

                <button type="submit" class="btn btn-primary">
                    <span class="material-symbols-outlined">search</span> Buscar
                </button>

                @if (!string.IsNullOrWhiteSpace(busqueda) || statusId > 0)
                {
                    <a asp-action="Index" class="btn btn-light">
                        <span class="material-symbols-outlined">close</span> Limpiar
                    </a>
                }
            </form>
            <span style="font-size:.8rem; color:var(--clr-text-muted);">@Model.TotalCount registro(s)</span>
        </div>

        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Descuento</th>
                        <th>Porcentaje</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Vigencia</th>
                        <th>Estado</th>
                        <th style="text-align:right;">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7">
                                <div class="empty-state">
                                    <div class="empty-state__icon">
                                        <span class="material-symbols-outlined">sell</span>
                                    </div>
                                    <div class="empty-state__title">Sin resultados</div>
                                    <p class="empty-state__text">No se encontraron descuentos con los filtros aplicados.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var disc in Model.Items)
                        {
                            var isActive = disc.Status?.Name?.Equals("Activo", StringComparison.OrdinalIgnoreCase) ?? false;
                            var vigente = isActive && disc.StartDate <= hoy && disc.EndDate >= hoy;
                            var expirado = disc.EndDate < hoy;

                            var vigenciaBadge = vigente
                                ? ("badge-admin", "Vigente")
                                : expirado
                                    ? ("badge-danger-outline", "Expirado")
                                    : ("badge-neutral", "Pendiente");

                            <tr>
                                <td>
                                    <div class="user-cell">
                                        <div class="user-cell__avatar"
                                             style="border-radius:var(--radius-sm); background:linear-gradient(135deg,#d97706,#92400e);">
                                            <span class="material-symbols-outlined" style="font-size:16px;">sell</span>
                                        </div>
                                        <div class="user-cell__name">@(disc.Name ?? "—")</div>
                                    </div>
                                </td>
                                <td>
                                    <strong style="font-size:1rem; color:var(--clr-primary);">
                                        @disc.Percentage.ToString("0.##")%
                                    </strong>
                                </td>
                                <td style="color:var(--clr-text-muted); font-size:.83rem;">
                                    @disc.StartDate.ToString("dd/MM/yyyy")
                                </td>
                                <td style="color:var(--clr-text-muted); font-size:.83rem;">
                                    @disc.EndDate.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    <span class="badge @vigenciaBadge.Item1">@vigenciaBadge.Item2</span>
                                </td>
                                <td>
                                    <div class="status">
                                        <span class="status-dot @(isActive ? "status-dot--active" : "status-dot--inactive")"></span>
                                        <span>@(disc.Status?.Name ?? "—")</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details" asp-route-id="@disc.DiscountId" class="btn btn-icon" title="Ver detalle">
                                            <span class="material-symbols-outlined">visibility</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@disc.DiscountId" class="btn btn-icon" title="Editar descuento">
                                            <span class="material-symbols-outlined">edit</span>
                                        </a>
                                        @if (isActive)
                                        {
                                            <a asp-action="Delete" asp-route-id="@disc.DiscountId"
                                                   class="btn btn-icon btn-danger-outline" title="Desactivar descuento">
                                                <span class="material-symbols-outlined">block</span>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            <span>
                Mostrando <strong>@Model.FirstItemIndex–@Model.LastItemIndex</strong>
                de <strong>@Model.TotalCount</strong> descuento(s)
            </span>

            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0" style="gap:4px;">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                                   asp-route-page="@(page - 1)"
                                   asp-route-busqueda="@busqueda"
                                   asp-route-statusId="@statusId">
                                <span class="material-symbols-outlined" style="font-size:16px;">chevron_left</span>
                            </a>
                        </li>
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-busqueda="@busqueda"
                                   asp-route-statusId="@statusId">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                                   asp-route-page="@(page + 1)"
                                   asp-route-busqueda="@busqueda"
                                   asp-route-statusId="@statusId">
                                <span class="material-symbols-outlined" style="font-size:16px;">chevron_right</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
