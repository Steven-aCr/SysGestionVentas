@model SysGestionVentas.EN.DocumentDetail

@{
    ViewData["Title"] = "Nuevo Detalle de Documento";
    ViewData["BreadcrumbParent"] = "Detalle de Documentos";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Nuevo Detalle de Documento</h1>
        <p class="page-header__subtitle">Agregue una línea de producto al documento.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver al listado
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">description</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Línea de Detalle</span>
            </div>
            <div style="padding:24px;">
                <form asp-action="Create" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom mb-4" role="alert"></div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">link</span>
                            Documento y Producto
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="DocumentId" class="form-label">Documento <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="DocumentId" asp-items="ViewBag.DocumentId" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="DocumentId" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ProductId" class="form-label">Producto <span style="color:var(--clr-danger)">*</span></label>
                                <select asp-for="ProductId" asp-items="ViewBag.ProductId" class="form-select" required>
                                    <option value="">— Seleccione —</option>
                                </select>
                                <span asp-validation-for="ProductId" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">shopping_cart</span>
                            Cantidad y Precio
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Quantity" class="form-label">Cantidad <span style="color:var(--clr-danger)">*</span></label>
                                <input asp-for="Quantity" class="form-control" type="number" min="1" placeholder="1" data-type="integer" required />
                                <span asp-validation-for="Quantity" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UnitPrice" class="form-label">Precio Unitario <span style="color:var(--clr-danger)">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                    <input asp-for="UnitPrice" class="form-control" type="number" step="0.01" min="0.01" placeholder="0.00" data-type="currency" required />
                                </div>
                                <span asp-validation-for="UnitPrice" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="DiscountAmount" class="form-label">Descuento ($)</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                    <input asp-for="DiscountAmount" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" data-type="currency" />
                                </div>
                                <span asp-validation-for="DiscountAmount" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <div class="form-section-title">
                            <span class="material-symbols-outlined">calculate</span>
                            Impuestos y Totales
                        </div>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Subtotal" class="form-label">Subtotal <span style="color:var(--clr-danger)">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                    <input asp-for="Subtotal" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" data-type="currency" required />
                                </div>
                                <span asp-validation-for="Subtotal" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TaxPercentage" class="form-label">IVA (%)</label>
                                <div class="input-group">
                                    <input asp-for="TaxPercentage" class="form-control" type="number" step="0.01" min="0" max="100" placeholder="13" />
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);color:var(--clr-text-muted);">%</span>
                                </div>
                                <span asp-validation-for="TaxPercentage" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TaxAmount" class="form-label">Monto IVA</label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                    <input asp-for="TaxAmount" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" data-type="currency" />
                                </div>
                                <span asp-validation-for="TaxAmount" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TotalAmount" class="form-label">Total Línea <span style="color:var(--clr-danger)">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:700;color:var(--clr-primary);">$</span>
                                    <input asp-for="TotalAmount" class="form-control" type="number" step="0.01" min="0" placeholder="0.00" data-type="currency" required />
                                </div>
                                <span asp-validation-for="TotalAmount" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Notes" class="form-label">Notas</label>
                                <input asp-for="Notes" class="form-control" placeholder="Observaciones opcionales…" />
                                <span asp-validation-for="Notes" class="text-danger" style="font-size:.78rem;"></span>
                            </div>
                        </div>
                    </div>

                    <hr style="border-color:var(--clr-border);margin:24px 0;" />

                    <div class="d-flex gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Guardar Detalle
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">
            <div class="alert-custom alert-warning-custom" style="border-radius:var(--radius-lg);">
                <span class="material-symbols-outlined" style="flex-shrink:0;">info</span>
                <div style="font-size:.81rem;">
                    <strong>Cálculo manual:</strong> Los campos de subtotal, IVA y total deben calcularse antes de guardar. El sistema no los calcula automáticamente en este formulario.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
