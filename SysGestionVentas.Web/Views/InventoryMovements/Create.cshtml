@model SysGestionVentas.EN.InventoryMovement
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Registrar Movimiento";
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Registrar Movimiento de Inventario</h1>
        <p class="page-header__subtitle">Registre una entrada, salida, ajuste, devolución o transferencia.</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">swap_vert</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Datos del Movimiento</span>
            </div>
            <div style="padding:24px;">
                <form asp-action="Create" class="needs-validation" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert-custom alert-danger-custom mb-4" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="InventoryId" class="form-label">
                            Producto / Inventario <span style="color:var(--clr-danger);">*</span>
                        </label>
                        <select asp-for="InventoryId" class="form-select" required>
                            <option value="">— Seleccione un producto —</option>
                            @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.InventoryList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="InventoryId" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MovementTypeId" class="form-label">
                            Tipo de Movimiento <span style="color:var(--clr-danger);">*</span>
                        </label>
                        <select asp-for="MovementTypeId" class="form-select" required>
                            <option value="">— Seleccione un tipo —</option>
                            @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.MovementTypeList)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <span asp-validation-for="MovementTypeId" class="text-danger" style="font-size:.78rem;"></span>
                        <small style="color:var(--clr-text-subtle);">
                            Entrada/Devolución suman stock · Salida/Transferencia lo reducen · Ajuste reemplaza el valor.
                        </small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Quantity" class="form-label">
                                Cantidad <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <input asp-for="Quantity" class="form-control"
                                   type="number" min="1" placeholder="Ej: 50"
                                   data-type="integer" required />
                            <span asp-validation-for="Quantity" class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="UnitCost" class="form-label">
                                Costo Unitario <span style="color:var(--clr-danger);">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text" style="background:var(--clr-surface-alt);border-color:var(--clr-border);font-weight:600;color:var(--clr-text-muted);">$</span>
                                <input asp-for="UnitCost" class="form-control"
                                       type="number" step="0.01" min="0.01"
                                       placeholder="0.00" data-type="currency" required />
                            </div>
                            <span asp-validation-for="UnitCost" class="text-danger" style="font-size:.78rem;"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label">Notas / Observaciones</label>
                        <textarea asp-for="Notes" class="form-control" rows="3"
                                  style="resize:vertical;" placeholder="Motivo del movimiento..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger" style="font-size:.78rem;"></span>
                    </div>

                    <hr style="border-color:var(--clr-border);margin:20px 0;" />

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary">
                            <span class="material-symbols-outlined">save</span>
                            Registrar Movimiento
                        </button>
                        <a asp-action="Index" class="btn btn-light">
                            <span class="material-symbols-outlined">close</span>
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div style="position:sticky;top:calc(var(--topbar-h) + 16px);">
            <div class="card">
                <div style="padding:14px 18px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                    <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:18px;">info</span>
                    <span style="font-size:.88rem;font-weight:700;color:var(--clr-text);">Tipos de Movimiento</span>
                </div>
                <div style="padding:18px;font-size:.82rem;color:var(--clr-text-muted);display:flex;flex-direction:column;gap:10px;">
                    <div class="d-flex gap-2 align-items-start">
                        <span class="badge badge-admin" style="flex-shrink:0;margin-top:1px;">Entrada</span>
                        <span>Incrementa el stock actual.</span>
                    </div>
                    <div class="d-flex gap-2 align-items-start">
                        <span class="badge badge-danger-outline" style="flex-shrink:0;margin-top:1px;">Salida</span>
                        <span>Decrementa el stock. Valida que haya suficiente.</span>
                    </div>
                    <div class="d-flex gap-2 align-items-start">
                        <span class="badge badge-cliente" style="flex-shrink:0;margin-top:1px;">Ajuste</span>
                        <span>Reemplaza el stock con la cantidad indicada.</span>
                    </div>
                    <div class="d-flex gap-2 align-items-start">
                        <span class="badge badge-admin" style="flex-shrink:0;margin-top:1px;">Devolución</span>
                        <span>Incrementa el stock (retorno de mercancía).</span>
                    </div>
                    <div class="d-flex gap-2 align-items-start">
                        <span class="badge badge-danger-outline" style="flex-shrink:0;margin-top:1px;">Transferencia</span>
                        <span>Decrementa el stock para traslado.</span>
                    </div>
                </div>
            </div>
            <div class="alert-custom alert-warning-custom mt-3" style="border-radius:var(--radius-lg);">
                <span class="material-symbols-outlined" style="flex-shrink:0;">warning</span>
                <div style="font-size:.81rem;">
                    Los movimientos son <strong>registros históricos inmutables</strong> una vez guardados.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}