@model SysGestionVentas.EN.InventoryMovement

@{
    ViewData["Title"] = "Eliminar Movimiento";
    var tipo = Model.MovementType?.Name ?? "—";
    var badgeClass = tipo switch
    {
        "Entrada" => "badge-admin",
        "Devolución" => "badge-admin",
        "Salida" => "badge-danger-outline",
        "Transferencia" => "badge-danger-outline",
        "Ajuste" => "badge-cliente",
        _ => "badge-neutral"
    };
}

<div class="page-header">
    <div>
        <h1 class="page-header__title">Eliminar Movimiento</h1>
        <p class="page-header__subtitle">#@Model.InventoryMovementId</p>
    </div>
    <div class="page-header__actions">
        <a asp-action="Index" class="btn btn-light">
            <span class="material-symbols-outlined">arrow_back</span>
            Volver
        </a>
    </div>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-lg-5 col-md-7">

        <div class="alert-custom alert-danger-custom mb-4" style="border-radius:var(--radius-lg);align-items:flex-start;">
            <span class="material-symbols-outlined" style="flex-shrink:0;margin-top:1px;">block</span>
            <div>
                <strong>Operación no permitida.</strong><br>
                Los movimientos de inventario son registros históricos inmutables y no pueden eliminarse. Para corregir un error de stock, registre un movimiento de <strong>Ajuste</strong>.
            </div>
        </div>

        <div class="card mb-4">
            <div style="padding:18px 22px;border-bottom:1px solid var(--clr-border);display:flex;align-items:center;gap:10px;">
                <span class="material-symbols-outlined" style="color:var(--clr-primary);font-size:20px;">swap_vert</span>
                <span style="font-size:.95rem;font-weight:700;color:var(--clr-text);">Datos del Movimiento</span>
            </div>
            <div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Producto</span>
                    <strong>@(Model.Inventory?.Product?.Name ?? $"Inv. #{Model.InventoryId}")</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Tipo</span>
                    <span class="badge @badgeClass">@tipo</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Cantidad</span>
                    <strong>@Model.Quantity</strong>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;border-bottom:1px solid var(--clr-border);font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Costo Unitario</span>
                    <span>$@Model.UnitCost.ToString("0.00")</span>
                </div>
                <div style="display:flex;justify-content:space-between;align-items:center;padding:13px 22px;font-size:.86rem;">
                    <span style="font-weight:600;color:var(--clr-text-muted);">Registrado</span>
                    <span style="color:var(--clr-text-muted);">@Model.CreatedAt.ToString("dd/MM/yyyy")</span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-3">
            <a asp-action="Create" class="btn btn-primary">
                <span class="material-symbols-outlined">tune</span>
                Registrar Ajuste
            </a>
            <a asp-action="Index" class="btn btn-light">
                <span class="material-symbols-outlined">close</span>
                Cancelar
            </a>
        </div>

    </div>
</div>