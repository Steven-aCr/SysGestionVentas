@model IEnumerable<SysGestionVentas.EN.DocumentDetail>
@using System.Linq
@{
    ViewData["Title"] = "Detalles de Documentos";
}
<h1>Detalles de Documentos</h1>
<p>
    <a asp-action="Create">Nuevo Detalle</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Document.DocNumber)</th>
            <th>@Html.DisplayNameFor(model => model.First().Product.Name)</th>
            <th>@Html.DisplayNameFor(model => model.First().Quantity)</th>
            <th>@Html.DisplayNameFor(model => model.First().UnitPrice)</th>
            <th>@Html.DisplayNameFor(model => model.First().Subtotal)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Document.DocNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.Product.Name)</td>
                <td>@Html.DisplayFor(modelItem => item.Quantity)</td>
                <td>@Html.DisplayFor(modelItem => item.UnitPrice)</td>
                <td>@Html.DisplayFor(modelItem => item.Subtotal)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.DocDetailId">Editar</a> |
                    <a asp-action="Details" asp-route-id="@item.DocDetailId">Detalles</a> |
                    <a asp-action="Delete" asp-route-id="@item.DocDetailId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>