@model SysGestionVentas.EN.DocumentDetail
@{
    ViewData["Title"] = "Detalle del Documento";
}
<h1>Detalle del Documento</h1>
<div>
    <h4>DocumentDetail</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Document)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Document.DocNumber)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.ProductList)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Quantity)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Quantity)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.UnitPrice)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.UnitPrice)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Subtotal)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Subtotal)</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.DocDetailId">Editar</a> |
    <a asp-action="Index">Volver al listado</a>
</div>