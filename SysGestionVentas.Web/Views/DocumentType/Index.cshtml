@model IEnumerable<SysGestionVentas.EN.DocumentType>

@{
    ViewData["Title"] = "Document Types";
}

<h1>Document Types</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Document Type</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Status ID</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var documentType in Model)
        {
            <tr>
                <td>@documentType.Name</td>
                <td>@documentType.Description</td>
                <td>@documentType.StatusId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@documentType.DocTypeId">Details</a> |
                    <a asp-action="Edit" asp-route-id="@documentType.DocTypeId">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@documentType.DocTypeId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
